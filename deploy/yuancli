# ============================================================ 设备访问
def normalize_bdf(text):
    text = text.strip()
    if text.count(":") == 1:                 # 6f:00.0
        return "0000:" + text
    if text.count(":") == 2:                 # 0000:6f:00.0
        return text
    raise SystemExit(f"BDF 写法不认识：{text}（应为 0000:6f:00.0 或 6f:00.0）")


class Card:
    """resource2 的 mmap 视图。所有 read/write 收 AVMM 地址（含 slot）。"""

    def __init__(self, bdf):
        self.bdf = normalize_bdf(bdf)
        path = f"/sys/bus/pci/devices/{self.bdf}/resource2"
        self.fd = os.open(path, os.O_RDWR | os.O_SYNC)
        size = os.fstat(self.fd).st_size
        self.map = mmap.mmap(self.fd, size, mmap.MAP_SHARED,
                             mmap.PROT_READ | mmap.PROT_WRITE)

    def close(self):
        self.map.close()
        os.close(self.fd)

    @staticmethod
    def bar2_off(avmm):
        return avmm << YNRDMA_ADDR_SHIFT

    def read(self, avmm):
        return struct.unpack_from("<I", self.map, self.bar2_off(avmm))[0]

    def write(self, avmm, value):
        if SLOT_SYS <= avmm < SLOT_SYS + 0x1000 and (avmm - SLOT_SYS) in SYS_GUARDED:
            raise SystemExit(
                f"拒绝写入 AVMM 0x{avmm:08x}：{SYS_GUARDED[avmm - SLOT_SYS]}。"
                f"\n确实要复位整片请用 `yuancli register reset_engine` / `softrst`，或走 setpci。")
        struct.pack_into("<I", self.map, self.bar2_off(avmm), value & 0xFFFFFFFF)
        self.map.flush()

    # ---- 分槽便捷访问 ----
    def roce(self, off):
        return self.read(SLOT_ROCE + off)

    def roce_write(self, off, value):
        self.write(SLOT_ROCE + off, value)

    def sys(self, off):
        return self.read(SLOT_SYS + off)

    def sys_write(self, off, value):
        self.write(SLOT_SYS + off, value)


# ============================================================ 表访问
def _wait_cmd_idle(card, timeout=0.2):
    t0 = time.time()
    while card.roce(REG_CMD_STATUS) & 1:
        if time.time() - t0 > timeout:
            raise TimeoutError("表命令一直 busy")


def table_access(card, write, table, index, data=None):
    """写/读一个表项，返回 64 字节原始数据（仅读）。"""
    _wait_cmd_idle(card)
    if data is not None:
        for i in range(16):
            card.roce_write(REG_CMD_DATA + 4 * i,
                            struct.unpack_from("<I", data, 4 * i)[0])
    card.roce_write(REG_CMD, (0x80000000 if write else 0) | (table << 24) | (index & 0xFFFFFF))
    _wait_cmd_idle(card)
    status = card.roce(REG_CMD_STATUS)
    if status & 2:
        raise IOError(f"表 {table} 索引 {index} 命令出错（越界或非法表号）")
    if write:
        return None
    return b"".join(struct.pack("<I", card.roce(REG_CMD_DATA + 4 * i)) for i in range(16))


def qpc_read(card, idx):
    raw = table_access(card, False, TBL_QPC, idx)
    dw = struct.unpack("<16I", raw)
    return raw, dw


def qp_tos_state(card):
    """返回 [(qp_idx, qpn, state, tos)]，只读。"""
    out = []
    for idx in range(QP_NUM):
        _, dw = qpc_read(card, idx)
        out.append((idx, dw[1] & 0xFFFFFF, dw[0] & 7, (dw[7] >> 16) & 0xFF))
    return out


def qpc_patch_tos(card, dscp=None, ecn=None):
    """逐 QP 改写 QPC dw7[23:16] = DSCP<<2 | ECN。返回被改的 qp_idx 列表。

    只改 state != RESET 的 QP：空 QP 由驱动在 create_qp 时整份重写，改了也留不住。
    注意 roce_tbl.sv:116 只在 state 变化时才触发动态状态重载，所以改 tos 不会
    打乱在途 PSN / 序号。
    """
    changed = []
    for idx in range(QP_NUM):
        raw, dw = qpc_read(card, idx)
        state = dw[0] & 7
        if state == QPS_RESET:
            continue
        tos = (dw[7] >> 16) & 0xFF
        new_tos = tos
        if dscp is not None:
            new_tos = (new_tos & 0x03) | ((dscp & 0x3F) << 2)
        if ecn is not None:
            new_tos = (new_tos & 0xFC) | (ecn & 0x03)
        if new_tos == tos:
            continue
        dw = list(dw)
        dw[7] = (dw[7] & ~(0xFF << 16)) | (new_tos << 16)
        table_access(card, True, TBL_QPC, idx, struct.pack("<16I", *dw))
        changed.append(idx)
    return changed


# ============================================================ 通用工具
def decode_caps(reg):
    return {
        "qp": 1 << (reg & 0xFF),
        "cq": 1 << ((reg >> 8) & 0xFF),
        "mr": 1 << ((reg >> 16) & 0xFF),
        "mtt": 1 << ((reg >> 24) & 0xFF),
    }


def fmt_mac(lo, hi):
    b = bytes([lo & 0xFF, (lo >> 8) & 0xFF, (lo >> 16) & 0xFF, (lo >> 24) & 0xFF,
               hi & 0xFF, (hi >> 8) & 0xFF])
    return ":".join(f"{x:02x}" for x in b)


def fmt_ip(v):
    return ".".join(str((v >> s) & 0xFF) for s in (0, 8, 16, 24))


def read_counters(card):
    return {name: card.roce(REG_CNT + 4 * i) for i, name in enumerate(COUNTERS)}


def pfc_decode(value):
    """0x054 的 9 位 PFC 字段 -> (pfc_on_prios, pause_on)"""
    prios = [i for i in range(8) if value & (1 << i)]
    return prios, bool(value & (1 << PFC_PAUSE_BIT))


def pfc_read(card):
    raw = card.sys(SYS_REG_TX_PFC)
    tx = raw & 0x1FF
    rx = (raw >> PFC_RX_SHIFT) & 0x1FF
    return tx, rx, raw


def pfc_write(card, value):
    card.sys_write(SYS_REG_TX_PFC, value & 0x1FF)
    return card.sys(SYS_REG_TX_PFC) & 0x1FF


def pfc_stats(card):
    rows = []
    for prio in range(8):
        rows.append({
            "prio": prio,
            "drop": card.sys(SYS_PFC_DROP + 4 * prio),
            "in": card.sys(SYS_PFC_IN + 4 * prio),
            "out": card.sys(SYS_PFC_OUT + 4 * prio),
        })
    return rows


def link_status(card):
    """链路：引擎 STATUS[0] + system_config 0x1BC 的 4 个 lane。"""
    engine = card.roce(REG_STATUS) & 1
    raw = card.sys(SYS_REG_LINK)
    lanes = [(raw >> i) & 1 for i in range(4)]
    return engine, lanes


def engine_alive(card):
    return card.roce(REG_ID) == ID_MAGIC


def require_engine(card):
    if not engine_alive(card):
        print(f"引擎不在线：ID = 0x{card.roce(REG_ID):08x}（期望 0x{ID_MAGIC:08x}）")
        print("可能是旧镜像、地址算错，或该 slot 没有被 roce_avm_split 接管。")
        raise SystemExit(1)


