        card.roce_write(CNP_TOS, (args.cnp_dscp << 2) & 0xFF)      # ECN 恒 00
        print(f"  CNP TOS  = 0x{card.roce(CNP_TOS):02X}（DSCP {card.roce(CNP_TOS) >> 2}）")
    if args.min_us is not None:
