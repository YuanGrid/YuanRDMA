        return 4
    ecn = int(value, 0)
    if not 0 <= ecn <= 3:
        raise SystemExit(f"--cnp_ecn 要在 0..3：{value}")
    tos = card.roce(CNP_TOS)
    card.roce_write(CNP_TOS, ((tos & 0xFC) | ecn) & 0xFF)
