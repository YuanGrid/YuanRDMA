    if ecn != 0:
        print("  警告：CNP 自己带 ECN≠00 会被交换机再标一次、引发 CNP 风暴，正常应保持 0。")
    return 0


def _set_cnp_bth_bit(card, value, bit, name, field):
    """读-改-写 CNP_BTH（0xA14）的单个位。

    B6433 及以前的镜像没有 0xA14，读回 0xdeadbeef；此时只提示、不写，避免把垃圾值
    回写进寄存器。BECN/FECN 是两个独立参数，各自只能改自己那一位，不能整字覆盖。
    """
    if not cnp_engine_present(card):
        print(f"{name}: RoCE ECN/CNP 不在线（0x{CNP_ID:03x} 读回 "
              f"0x{card.roce(CNP_ID):08x}）。")
        return 4
    v = int(value, 0)
    if v not in (0, 1):
        raise SystemExit(f"{name} 只能取 0|1：{value}")
    cur = card.roce(CNP_BTH)
    if no_reg(cur):
        print(f"{name}: 0x{CNP_BTH:03x} 读回 0x{cur:08x} —— "
              f"该镜像没有 0xA14（CNP_BTH），需要 B6434 及以上。未写任何寄存器。")
        return 4
    new = (cur & ~(1 << bit)) | (v << bit)
    card.roce_write(CNP_BTH, new & 0x3)
    after = card.roce(CNP_BTH)
    print(f"  CNP BTH = 0x{after:02X}（BECN={after & 1} FECN={(after >> 1) & 1}，"
          f"{field}={v} → byte4 = 0x{(after << 6):02X}）")
    if (after & 3) != (new & 3):
        print(f"  提示：回读与写入不一致（0x{after:02X} vs 0x{new:02X}），检查 Bus Master / BAR2。")
        return 1
    return 0


def h_cnp_b(card, value):
    return _set_cnp_bth_bit(card, value, 0, "--cnp_b", "BECN")


def h_cnp_f(card, value):
    return _set_cnp_bth_bit(card, value, 1, "--cnp_f", "FECN")


