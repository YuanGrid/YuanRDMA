def canon(args):
    """把 args.group / args.cmd 归一成规范名。"""
    args.group = GROUP_ALIAS.get(args.group, args.group)
    if getattr(args, "cmd", None):
        args.cmd = CMD_ALIAS.get(args.cmd, args.cmd)
    return args


def run_command(argv):
    """执行一条命令，返回退出码。命令行和交互 shell 共用。"""
    if argv and argv[0] in LEGACY:
        argv = ["reg"] + list(argv)

    args = canon(build_parser().parse_args(argv))

    # capabilities 是纯静态的 RTL 能力表，不需要碰硬件，也就不需要 -d
    if args.group == "capabilities":
        return cmd_caps(args.json)

    try:
        card = Card(args.device)
    except FileNotFoundError:
        raise SystemExit(f"找不到 {args.device} 的 resource2（卡不在总线上？）")
    except PermissionError:
        raise SystemExit("需要 root 权限访问 resource2")

    try:
        if args.group == "quality_of_service":
            require_engine(card)
            if args.show:
                return show_qos(card)
            if args.clear_stats:
                card.sys_write(SYS_REG_STATS_CLEAR, 1)
                time.sleep(0.01)
                card.sys_write(SYS_REG_STATS_CLEAR, 0)
                print("已清 PFC 与全部 debug 计数器（0x01200030）。")
                return 0
            if args.pfc is not None:
                return do_pfc(card, args.pfc, args.priority, args.state)
            rc = dispatch_params(card, "qos", args)
            return rc

        if args.group == "pfc":
            if args.pfc_cmd == "status":
                return cmd_pfc_engine_status(card, getattr(args, "json", False) or args.json)
            if args.pfc_cmd == "config":
                _require_pfc_engine(card)
                return cmd_pfc_engine_config(card, args)
            if args.pfc_cmd == "counters":
                return cmd_pfc_engine_counters(card, getattr(args, "json", False) or args.json,
                                               getattr(args, "diff", 0.0))
            if args.pfc_cmd == "clear":
                _require_pfc_engine(card)
                card.roce_write(PFC_CLEAR, 1)
                print("已清 RoCE 引擎 PFC 全部计数器（0x09FC）。")
                print("注：DROP 计数来自 mac 域的源计数器，清的是 core 域的基线，之后从头计数。")
                return 0
            # force_xoff（含旧的 enable/disable 别名）：写 system_config 0x054
            if args.pfc_cmd == "force_xoff":
                # --pause 是 pfc 一级的 nargs="?" 选项（const="on"），取 None/on/off 三态
                return do_pfc_force_xoff(card, args.mask, args.priority, args.state,
                                         _pause_arg(args.pause))
            spec = getattr(args, "priority", None)
            prios = _parse_prios(spec) if spec else set(range(8))
            print(f"注意：`pfc {args.pfc_cmd}` 是旧名，语义是**强制** XOFF（等同 force_xoff），"
                  f"不是打开自动 PFC。")
            pause = _pause_arg(args.pause)
            return cmd_pfc_set(card, prios, args.pfc_cmd == "enable", pause)

        if args.group == "dcqcn":
            if args.dcqcn_cmd == "status":
                return cmd_dcqcn_status(card, getattr(args, "json", False) or args.json)
            if args.dcqcn_cmd == "config":
                _require_dcqcn_engine(card)
                return cmd_dcqcn_config(card, args)
            if args.dcqcn_cmd == "qp":
                return cmd_dcqcn_qp(card, args.selection, getattr(args, "json", False) or args.json)
            if args.dcqcn_cmd == "counters":
                return cmd_dcqcn_counters(card, getattr(args, "json", False) or args.json,
                                          getattr(args, "diff", 0.0))
            if args.dcqcn_cmd == "clear":
                _require_dcqcn_engine(card)
                card.roce_write(DCQCN_CLEAR, 1)
                print("已清 DCQCN 计数器（0x0BFC）。")
                return 0

        if args.group == "ecn":
            if args.ecn_cmd == "status":
                return cmd_ecn_status(card, getattr(args, "json", False) or args.json)
            if args.ecn_cmd == "config":
                _require_cnp_engine(card)
                return cmd_ecn_config(card, args)
            if args.ecn_cmd == "counters":
                return cmd_ecn_counters(card, getattr(args, "json", False) or args.json,
                                        getattr(args, "diff", 0.0))
            if args.ecn_cmd == "clear":
                _require_cnp_engine(card)
                card.roce_write(CNP_CLEAR, 1)
                print("已清 ECN/CNP 计数器（0x0AFC）。")
                return 0

        if args.group == "congestion_control":
            require_engine(card)
            if args.show:
                return show_flexcc(card)
            return dispatch_params(card, "flexcc", args)

        if args.group == "roce_acceleration":
            if args.show:
                return show_roce_accl(card)
            return dispatch_params(card, "roce_accl", args)

        if args.group == "register":
            if args.cmd == "probe_engine":
                return cmd_probe(card, args.json)
            if args.cmd == "dump_registers":
                return cmd_dump(card, args.json)
            if args.cmd == "read_counters":
                return cmd_counters(card, args.json)
            if args.cmd == "watch_counters":
                return cmd_watch(card, args.interval, args.count)
            if args.cmd == "bas_status":
                return cmd_dbg(card, args.json)
            if args.cmd == "dump_debug_registers":
                if args.scan:
                    rc = cmd_dbgscan(card, as_json=args.json)
                    if rc:
                        return rc
                return cmd_dbgall(card, args.json, diff=args.diff)
            if args.cmd == "scan_registers":
                return cmd_dbgscan(card, as_json=args.json)
            if args.cmd == "lanes":
                return cmd_lanes(card, args.json,
                                 clear_peak=args.clear_peak, diff=args.diff)
            if args.cmd == "rx_pkts":
                return cmd_rx_pkts(card, args.json, lane_text=args.lane,
                                   diff=args.diff, clear_peak=args.clear_peak)
            if args.cmd == "rdmacore":
                return cmd_rdmacore(card, args.json, lane_text=args.lane, diff=args.diff)
            if args.cmd == "rx_demux":
                return cmd_rx_demux(card, args.json, lane_text=args.lane, diff=args.diff)
            if args.cmd == "tx_merge":
                return cmd_tx_merge(card, args.json, diff=args.diff)
            if args.cmd == "dump_stall_snapshot":
                return cmd_dump_stall_snapshot(card, args.json,
                                               force=args.force, clear=args.clear)
            if args.cmd == "bus_master":
                return cmd_busmaster(card, args.enable)
            if args.cmd == "reset_engine":
                return cmd_reset(card)
            if args.cmd == "soft_reset":
                return cmd_softrst(card)
            if args.cmd == "read_address":
                v = card.read(args.avmm)
                if v == 0xDEADBEEF:
                    print(f"AVMM 0x{args.avmm:08x} = 0xdeadbeef"
                          f"  <- 该地址没有寄存器（avm_config 默认返回）")
                else:
                    print(f"AVMM 0x{args.avmm:08x} (BAR2 0x{card.bar2_off(args.avmm):08x})"
                          f" = 0x{v:08x}")
                return 0
            if args.cmd == "write_address":
                card.write(args.avmm, args.value)
                v = card.read(args.avmm)
                print(f"AVMM 0x{args.avmm:08x} <- 0x{args.value:08x} (回读 0x{v:08x})")
                return 0
    finally:
        card.close()
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # 交互式 shell
    if argv and argv[0] in ("shell", "-i", "--interactive"):
        return interactive_shell()

    # 不带参数时列出下一级（比 argparse 的 usage 报错友好），
    # -h/--help 仍然走完整的 argparse 帮助
    if not argv:
        print_level_help([])
        print("用 `yuancli <命令> -h` 看某个命令的完整帮助，或 `yuancli shell` 进入交互模式。")
        return 0

    # `yuancli pfc` 不带子命令：打完整帮助，而不是 argparse 的一行「pfc_cmd 必填」。
    # 只对 pfc 做，其它命令组的行为保持不变。用已有的 _walk/_subparsers 判断命令树，
    # 不另立清单：argv[1:] 里没有任何 token 命中 pfc 的子命令名就算「没给子命令」。
    if argv[0] == "pfc" and not any(a in ("-h", "--help", "?") for a in argv[1:]):
        _pf, _used = _walk(["pfc"])
        _sp = _subparsers(_pf)
        if _sp is not None and not any(a in _sp.choices for a in argv[1:]):
            _pf.print_help()
            print("用 `yuancli pfc <子命令> -h` 看某个子命令的用法。")
            return 0

    # 就地提示：yuancli ? / yuancli register ? / yuancli register dump_debug_registers ?
    # 注意 bash 会把裸 ? 当通配符展开成当前目录下的单字符文件名，必要时写成 '?'
    if "?" in argv:
        return print_level_help(argv[:argv.index("?")])

    # `yuancli ecn` / `yuancli dcqcn` 只给了组名：这两组底下是必选的子命令，
    # 直接交给 argparse 只会打一行 "required: ecn_cmd"，把整份带示例的 help 打出来更有用。
    # 命令树是 build_parser() 建的，这里沿着它走，走到「还有子命令、但没给子命令」的
    # 那一级就打该级的完整帮助（与 -h 是同一份）。组级只有 -d/-j，跟着给也算。
    parser_at, walked = _walk(argv)
    if (argv[0] in ("ecn", "dcqcn") and walked
            and _subparsers(parser_at) is not None):
        rest = list(argv[walked:])
        leftover = []
        while rest:
            tok = rest.pop(0)
            if tok in ("-j", "--json"):
                continue
            if tok in ("-d", "--device"):
                if rest:
                    rest.pop(0)
                continue
            if tok.startswith("--device="):
                continue
            leftover.append(tok)       # 子命令或错字，交回 argparse 报错
            leftover.extend(rest)
            break
        if not leftover:
            parser_at.print_help()
            return 0

    return run_command(argv)


if __name__ == "__main__":
    sys.exit(main())
