    card.roce_write(PFC_WD_TX_US, us)
    print(f"  WD_TX_US = {card.roce(PFC_WD_TX_US)} µs"
          f"（CTRL2.RX_WD_EN={'on' if card.roce(PFC_CTRL2) & 0x10 else 'off'}，"
