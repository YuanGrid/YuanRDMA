  yuancli quality_of_service -d 6f:00.0 --show                 # PFC + 计数 + 每 QP 的 DSCP/ECN
  yuancli quality_of_service -d 6f:00.0 --clear_stats          # 清 PFC 与全部 debug 计数
""")
    qos.add_argument("-d", "--device", default=DEFAULT_BDF, help=f"目标 BDF（默认 {DEFAULT_BDF}）")
    qos.add_argument("--show", action="store_true", help="显示 PFC / 计数 / 每 QP 的 DSCP 与 ECN")
    qos.add_argument("--pfc", nargs="?", const="", default=None, metavar="MASK",
                     help="开/关 PFC：配合 -p X -s on|off，或直接给 8 位掩码 0,0,0,1,0,0,0,0")
    qos.add_argument("--clear_stats", action="store_true",
                     help="写 0x030 清 PFC 与全部 debug 计数器（会影响 ETH 侧计数）")
    add_params(qos, QOS_PARAMS)
    qos.add_argument("-p", "--priority", type=int, help="PFC 优先级 0-7（配合 --pfc）")
    qos.add_argument("-s", "--state", choices=["on", "off"], help="开/关（配合 --pfc）")

    # ---------------- pfc ----------------
    pfcp = sub.add_parser(
        "pfc",
        help="PFC：status / config / counters / clear（RoCE 引擎 roce_pfc，0x800 窗口）"
             "；force_xoff（0x054 强制 XOFF，调试）",
        description="""PFC 分两部分：
  · RoCE 引擎的 PFC 控制器（roce_pfc，AVMM 0x0170_0800..0x0170_09FC）：收方向的准入
    （honor 掩码 / 看门狗 / ANY_ALL）与发方向的自动 XOFF（staging 水位 → XOFF，迟滞 +
    最短保持 + 升级为整体暂停）。这是 full_pfc_func 镜像才有的硬件。
  · system_config 的 tx_pfc（0x054）：**强制**电平，软件写什么就往 MAC 送什么，
    不经过任何水位判断。只给调试/上板验证用，就是 force_xoff 子命令。

旧版的 `pfc enable/disable` 就是 force_xoff，保留为别名（语义本来就是「一直按住对端」，
名字起错了）。

优先级从哪来
  以太网帧 IPv4 头的 TOS[7:5]，也就是 prio = DSCP >> 3（roce_pfc_egress.sv 按帧头
  第 15 字节取 3 bit）。**不走 VLAN PCP**：RoCE 出口帧不带 VLAN tag，pfc_parser 的
  VLAN PCP 分类只作用于 QDMA / 普通以太网路径。
  RoCE 引擎的 DSCP 来自 QPC dw7[23:16]，逐 QP 设：
      yuancli congestion_control --force_dscp 24   # DSCP 24 -> prio 3
  DSCP 24 落在 prio3，所以「给 prio3 开 PFC」= 上面这条 + 两端都开 prio3。
  QP 由 libibverbs 重建后要重打一次。

两个方向的掩码（都在 0x800 窗口，本机一侧）
  发方向 --tx-mask（0x808，复位 0xFF）：哪些优先级**有权单独**发 XOFF。掩码里的优先级
    按自己的水位单独暂停对端；掩码外的优先级拥塞时不单独暂停，而是升级为整体暂停——
    CTRL2.MODE8=0 时把 TX_MASK 里的优先级全部拉高（PFC 全停），MODE8=1 时改发一路
    802.3x PAUSE（所有优先级一起停）。任一 lane 总占用 ≥ ALL_THR 或 CTRL2.GLOBAL=1
    也走同一条升级路径。
  收方向 --rx-honor（0x80C，复位 0x1FF）：理会哪些优先级发来的 PFC，低 8 位逐优先级，
    bit8 单独管 802.3x PAUSE。只理会 prio0/prio2 但仍理会 802.3x = 0x105，连 802.3x
    也不理会 = 0x005。

本机设了还要对端也设
  本机掩码只决定「我怎么发 / 我怎么理会」，对端不理会的优先级等于没开。对端（CX7）：
      mlnx_qos -i port1 --pfc 1,0,1,0,0,0,0,0   # 8 位依次 prio0..7，这里 = prio0+prio2
  对端把某个优先级丢掉不发 PFC，本机 --rx-honor 开着也收不到 pause。""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例（分场景，按需照抄）

  ── 只给 prio0 + prio2 开 PFC（最常问的一条）──────────────
  yuancli pfc config --tx-mask 0x05 --rx-honor 0x105
      # 发方向：只有 prio0/prio2 可单独发 XOFF，其余优先级拥塞时升级为整体暂停
      # 收方向：只理会 prio0/prio2 的 PFC，但仍然理会 802.3x（bit8=1）
      # 判读：pfc status 的 TX_MASK 0x05 / RX_HONOR 0x105；对端要配
      #       mlnx_qos -i port1 --pfc 1,0,1,0,0,0,0,0
  yuancli pfc config --rx-honor 0x005
      # 同上，但连 802.3x PAUSE 也不理会（对端发的整体 pause 直接忽略）

  ── 先确认流量真的落在 prio0/prio2 上 ───────────────────
  yuancli congestion_control --show              # 看每个 QP 的 DSCP/ECN
  yuancli congestion_control --force_dscp 0      # DSCP 0  -> prio0
  yuancli congestion_control --force_dscp 16     # DSCP 16 -> prio2
      # 优先级是 TOS[7:5]=DSCP>>3，不是 VLAN PCP；QP 重建后要重打

  ── 只开 802.3x（不分优先级，整体暂停）────────────────────
  yuancli pfc config --tx-mask 0x00 --ctrl2 0x2
      # TX_MASK 清 0 = 没有任何优先级能单独暂停，拥塞全部升级；
      # CTRL2.MODE8=1 = 升级的形式就是 802.3x PAUSE
      # 判读：pfc status 的「我方发出」里 802.3x=是、per-prio 为空

  ── 关掉自动发送，只统计（不干扰对端）────────────────────
  yuancli pfc config --ctrl 0xE
      # CTRL 位定义：[0]TX_EN [1]RX_EN [2]RESP_GATE [3]EGRESS_GATE，复位 0xF。
      # 0xE = 清 bit0，不再自动发 XOFF，但 RX 仍会按收到的 pause 停发、
      #       RESP 仍受约束、出口仍按帧头 TOS 挡帧。只观察、不干预对端的基线状态。
  yuancli pfc config --ctrl 0x0
      # 四项全关：RX 也不再理会任何 pause。A/B 对照的另一端
  yuancli pfc config --ctrl 0xF
      # 全开，回到复位值（收尾用）

  ── 只理会部分优先级（收方向细调）────────────────────────
  yuancli pfc config --rx-honor 0x1FF            # 全理会（复位值）
  yuancli pfc config --rx-honor 0x100            # 只理会 802.3x，per-prio PFC 全忽略
  yuancli pfc config --rx-honor 0x000            # 谁都不理会 = A/B 对照组

  ── 调阈值 / 最短保持（单位：1 拍 = 128 B）──────────────
  yuancli pfc config --xoff-thr 256,256,256,64,256,256,256,256
      # 只把 prio3 的 XOFF 水位从 256 拍（32 KB）降到 64 拍（8 KB），更早发 XOFF；
      # 逗号分隔必须给满 8 个，顺序就是 prio0..prio7
  yuancli pfc config --xon-thr 128,128,128,32,128,128,128,128
      # XON 水位跟着降，保持 XOFF/XON 迟滞（复位 256/128）；xon >= xoff 会来回抖
  yuancli pfc config --hold-us 100
      # XOFF 最短保持 100 µs（复位 10）。太小对端来不及停，太大吞吐掉

  ── 看门狗 ───────────────────────────────────────────────
  yuancli pfc config --wd-tx-us 100000           # 我方 XOFF 超过 100 ms 强制放开（复位值，0 = 关）
  yuancli pfc config --wd-rx-us 1000 --ctrl2 0x10
      # 接收看门狗：对端按住超过 1 ms 就自己恢复；必须先置 CTRL2.RX_WD_EN=1
      # 判读：pfc status 的「RX 看门狗命中」/ tx_wd_trip 计数

  ── A/B 对照与收尾 ───────────────────────────────────────
  yuancli pfc counters --diff 2                  # 2 s 内的速率，看 XOFF 是否在抖
  yuancli pfc clear                              # 清基线，然后重跑一次同样工况对比
  yuancli pfc config --ctrl 0xF --ctrl2 0x0 --tx-mask 0xFF --rx-honor 0x1FF
      # 恢复复位配置

  ── 强制 XOFF（只为验证对端是否理会，不是开 PFC）─────────
  yuancli pfc force_xoff -p 0 -s on              # 按住对端 prio0
  yuancli pfc force_xoff -p 0 -s off             # 放开；常开会把对端 RX 队列填死
""")
    pfcp.add_argument("-d", "--device", default=DEFAULT_BDF, help=f"目标 BDF（默认 {DEFAULT_BDF}）")
    pfcp.add_argument("-j", "--json", action="store_true", help="status/counters 以 JSON 输出")
    pfcp.add_argument("--pause", nargs="?", const="on", choices=["on", "off"],
                      help="（force_xoff 用）同时设置 802.3x PAUSE（bit8），不给值等于 on")
    pfsub = pfcp.add_subparsers(dest="pfc_cmd", required=True)
    st = pfsub.add_parser(
        "status",
        help="查看引擎 PFC 配置、生效 pause 与计数",
        description="""打印 roce_pfc（0x800 窗口）的当前配置 + 生效状态 + staging 占用 + 计数。

判读顺序：先看 CTRL / CTRL2 是不是你要的开关组合，再看 TX_MASK / RX_HONOR 两个掩码，
再看「生效 pause」和「我方发出」两行，最后才看计数。计数只列非零项，全量用
`yuancli pfc counters`。""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例
  yuancli pfc status
      # 全貌：CTRL/CTRL2、TX_MASK、RX_HONOR、阈值、staging 占用、非零计数
  yuancli pfc status -j
      # JSON，给脚本用
  yuancli pfc status | grep -E 'TX_MASK|RX_HONOR'
      # 只核对「只给 prio0/prio2 开」是否生效：期望 0x05 / 0x105

  判读要点
    RX_HONOR 0x105 = 理会 prio0/prio2 的 PFC + 仍理会 802.3x；0x005 = 连 802.3x 也不理
    「我方发出」的 per-prio 位 = 当前正在按住对端的优先级；稳态不应长时间常亮
    WD_WARN 显示 n/a(B6434+) 是正常的：当前 bitstream 的 0x82C 读 mux 缺失，读回
    0xdeadbeef；修好后重新编译才会出数
    「升级中 / 出口挡帧中」长时间为「是」说明拥塞严重或阈值定得太低
""")
    st.add_argument("-j", "--json", action="store_true", help="以 JSON 输出")
    cfg = pfsub.add_parser(
        "config",
        help="写入引擎 PFC 配置（不给参数则显示配置）",
        description="""写 roce_pfc（0x800 窗口）的配置寄存器。**只写你给的字段**，没给的保持原值。

CTRL / CTRL2 是**整字覆盖**，改一位也会把同一寄存器里其它位一起写回；其余字段各自
独立写。写完回读并打印，回读不对就说明寄存器没写进去。""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""示例
  yuancli pfc config                             # 不给参数 = 只显示当前配置（等同 status 配置段）
  yuancli pfc config --tx-mask 0x05 --rx-honor 0x105
