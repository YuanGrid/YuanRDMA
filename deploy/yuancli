def do_pfc_force_xoff(card, spec, priority, state, pause=None):
    """force_xoff：直接按住 system_config 的 tx_pfc（0x054）——调试用，会一直停住对端。

    旧版 `yuancli pfc enable` 就是这个语义，但名字让人以为它是「使能自动 PFC」。
    真正自动的 PFC 是 RoCE 引擎的 roce_pfc（`yuancli pfc config/status`），那边由
    staging 水位驱动，不需要软件参与。

    pause（`--pause on|off`，B6462 上板时修的缺陷 2026-11-22）：写 bit8 = 802.3x PAUSE。
    此前本函数签名里没有 pause、caller 也不传，帮助里 `--pause=on force_xoff` 的示例
    是空操作，只写 bit0——曾据此误判「对端不理 PFC」。None = 不动 bit8。
    """
    tx_before, _, _ = pfc_read(card)
    if spec:
        new = parse_pfc_mask(spec)
        how = f"整字节掩码 {spec}"
    else:
        if priority is None or state is None:
            raise SystemExit("force_xoff 需要 -p <0-7> -s <on|off>，或 --mask 0,0,0,1,0,0,0,0")
        new = (tx_before | (1 << priority)) if state == "on" else (tx_before & ~(1 << priority))
        how = f"prio {priority} -> {'按住' if state == 'on' else '放开'}"
    # bit8 的三种状态都按 `pause` 的取值处理（见 PFC_TX_BITS），与 cmd_pfc_set 同口径
    if pause is not None:
        new = (new | 0x100) if pause else (new & ~0x100)
        how += "，802.3x " + ("按住" if pause else "放开")
    readback = pfc_write(card, new)
    print(f"tx_pfc 0x054 : 0x{tx_before:03x} -> 0x{readback & 0x1FF:03x}   ({how})")
    print("警告：这是**强制** XOFF，只要掩码里还有置位，对端就一直被停住。")
    print("      正常 PFC 请用 `yuancli pfc config --ctrl` 打开 roce_pfc 的自动发送。")
    return 0 if (readback & 0xFF) == (new & 0xFF) else 1


def do_pfc(card, spec, priority, state):
    tx_before, _, _ = pfc_read(card)
    if spec:
        new = parse_pfc_mask(spec)
        how = f"整字节掩码 {spec}"
    else:
        if priority is None or state is None:
            raise SystemExit("--pfc 需要 -p <0-7> -s <on|off>，或 --pfc 0,0,0,1,0,0,0,0")
        if not 0 <= priority <= 7:
            raise SystemExit(f"优先级要在 0..7：{priority}")
        if state == "on":
            new = tx_before | (1 << priority)
        else:
            new = tx_before & ~(1 << priority)
        how = f"prio {priority} -> {state}"
    readback = pfc_write(card, new)
    ok = (readback & 0xFF) == (new & 0xFF)
    prios, _ = pfc_decode(readback)
    print(f"tx_pfc       : 0x{tx_before:03x} -> 0x{readback & 0x1FF:03x}   ({how})")
    print(f"PFC 使能队列 : {prios if prios else '（无）'}")
    if not ok:
        print("回读与写入不一致 —— 寄存器没写进去，检查 Bus Master / BAR2 映射。")
        return 1
    print("已生效：tx_pfc[7:0] 直接驱动 eth400g MAC 的 PFC 帧生成。")
    return 0


def do_force_dscp(card, value):
    value = int(value, 0)
    if value == 255:
        print("--force_dscp 255 = 不覆盖，使用 ibverbs/QPC 原本的 DSCP。未改动任何 QP。")
        return 0
    if not 0 <= value <= 63:
        raise SystemExit(f"DSCP 要在 0..63：{value}")
    changed = qpc_patch_tos(card, dscp=value)
    if not changed:
        print(f"没有 QP 被改动（16 个 QP 全部处于 RESET，或本来就是 DSCP {value}）。")
        print("先跑起 perftest 建好 QP，再执行一次即可在线生效。")
        return 0
    print(f"已把 DSCP {value} 写入 QP {changed} 的 QPC dw7[23:16]。")
    print("注意：QP 由 libibverbs 创建，重建 QP 后需要重新执行本命令。")
    return 0


def do_data_ecn(card, value):
    value = int(value, 0)
    if not 0 <= value <= 3:
        raise SystemExit(f"--data_ecn 取值 0..3：{value}")
    changed = qpc_patch_tos(card, ecn=value)
    names = {0: "Not-ECT", 1: "ECT(1)", 2: "ECT(0)", 3: "CE"}
    if not changed:
        print(f"没有 QP 被改动（全部 RESET，或本来就是 ECN {names[value]}）。")
        return 0
    print(f"已把数据报文 ECN 设为 {value}（{names[value]}），涉及 QP {changed}。")
    if value == 3:
        print("警告：CE 是「已拥塞」标记，交换机看到会直接丢弃或触发 CNP。")
        print("      正常端点应发 ECT(0)=2，由交换机打 CE。")
    return 0


