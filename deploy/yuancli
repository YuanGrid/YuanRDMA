def cmd_ecn_status(card, as_json=False):
    """ECN/CNP 全貌：配置、限频窗口、五个计数器（带 NP/RP 角色说明）。"""
    ctrl = card.roce(CNP_CTRL)
    tos = card.roce(CNP_TOS)
    status = card.roce(CNP_STATUS)
    cnt = {name: card.roce(CNP_CNT(index)) for name, index, _ in CNP_CNT_NAMES}
    out = {
        "bdf": card.bdf,
        "id": f"0x{card.roce(CNP_ID):08x}",
        "ctrl": ctrl, "ctrl_enabled": _decode_bits(ctrl, CNP_CTRL_BITS),
        "tos": tos, "cnp_dscp": tos >> 2, "cnp_ecn": tos & 0x3,
        "min_time_between_cnps_us": card.roce(CNP_MIN_US),
        "waiting": bool(status & 1), "window_open": bool(status & 2),
        "counters": cnt,
    }
    if as_json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    print(f"RoCE ECN / CNP（NP 侧）   BDF {card.bdf}   ID {out['id']}")
    print(f"  CTRL 0x{ctrl:02X}：{', '.join(out['ctrl_enabled']) or '（全关）'}")
    print(f"  CNP TOS 0x{tos:02X}：DSCP {tos >> 2}, ECN {tos & 3}"
          f"（{'正确，CNP 不会被再标 CE' if (tos & 3) == 0 else '警告：ECN 必须为 00'}）")
    bth = card.roce(CNP_BTH)
    if bth != 0xDEADBEEF:
        print(f"  CNP BTH 0x{bth:02X}：BECN={bth & 1} FECN={(bth >> 1) & 1}"
              f"（byte4 = 0x{(bth << 6):02X}；B6434 起可配）")
    print(f"  端口级最小间隔 min_time_between_cnps = {card.roce(CNP_MIN_US)} µs"
          f"{'（不限频）' if card.roce(CNP_MIN_US) == 0 else ''}")
    print(f"  当前：{'有 lane 在等 grant  ' if status & 1 else ''}{'限频窗口开着' if status & 2 else '限频窗口关闭'}"
          f"{'  （空闲）' if status == 0 else ''}")
    print()
    print("  计数器（与业界通用计数同名）：")
    for name, index, desc in CNP_CNT_NAMES:
        print(f"    {name:<32s} {cnt[name]:>12d}   {desc}")
    print()
    print("  判读：")
    print("    np_ecn_marked_roce_packets > 0 而 np_cnp_sent 小 → 交换机在标 CE、CNP 被限频（正常）")
    print("    np_cnp_sent > 0 而 rp_cnp_handled = 0     → 对端没收到 CNP 或对端是别的实现")
    print("    rp_cnp_ignored > 0                        → 收到 CNP 但 QP 不在 RTS，检查建链")
    return 0


