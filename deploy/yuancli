def cmd_watch(card, interval, count):
    require_engine(card)
    prev = None
    n = 0
    try:
        while count <= 0 or n < count:
            now = read_counters(card)
            status = card.roce(REG_STATUS)
            if prev is None:
                print(f"# t=0s link={'UP' if status & 1 else 'DOWN'}")
                for name in COUNTERS:
                    print(f"  {name:<16s} {now[name]:>12d}")
            else:
                deltas = {k: now[k] - prev[k] for k in COUNTERS if now[k] != prev[k]}
                if deltas:
                    stamp = time.strftime("%H:%M:%S")
                    body = " ".join(f"{k}+{v}" for k, v in deltas.items())
                    print(f"{stamp} link={'UP' if status & 1 else 'DOWN'} {body}")
            prev = now
            n += 1
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    return 0


def cmd_busmaster(card, enable):
    """检查（可选：打开）PCI COMMAND 的 Memory Space + Bus Master。

    BAS 是 FPGA 主动发起的主机内存访问，bit1/bit2 必须为 1，否则事务发不出去，
    表现为「数据不落地、完成信号不来」，很容易误判成 RTL 故障。
    rmmod yuanmcdma 会 pci_disable_device() 把这两位清掉；bus reset 后回到 0x0000。
    所以上板顺序是先 insmod yuanmcdma.ko，再跑 BAS 相关操作。
    """
    path = f"/sys/bus/pci/devices/{card.bdf}/config"
    fd = os.open(path, os.O_RDWR | os.O_SYNC)
    cmd = struct.unpack("<H", os.pread(fd, 2, 0x04))[0]
    mem = bool(cmd & 0x2)
    bm = bool(cmd & 0x4)
    print(f"BDF          : {card.bdf}")
    print(f"COMMAND      : 0x{cmd:04x}")
    print(f"Memory Space : {'ON ' if mem else 'OFF'}  (bit1)")
    print(f"Bus Master   : {'ON ' if bm else 'OFF'}  (bit2)  <- BAS 必需")
    if bm and mem:
        print("BAS 前置条件满足。")
        os.close(fd)
        return 0
    if not enable:
        print()
        print("BAS 事务现在发不出去。处理办法（按优先级）：")
        print("  1) insmod yuanmcdma.ko                     # 驱动会 pci_enable_device()")
        print(f"  2) setpci -s {card.bdf} COMMAND=0546    # 无驱动时手工开")
        print("  3) yuancli register bus_master --enable       # 本工具直接开")
        os.close(fd)
        return 1
    new = cmd | 0x2 | 0x4
    os.pwrite(fd, struct.pack("<H", new), 0x04)
    check = struct.unpack("<H", os.pread(fd, 2, 0x04))[0]
    os.close(fd)
    print(f"已写入 COMMAND=0x{new:04x}（回读 0x{check:04x}）")
    return 0


def cmd_dbg(card, as_json):
    """读 BAS 观测与 RX 状态调试寄存器（0x0400 / 0x0404 / 0x0410）。

    判读规则（跑一次 DMA 自测或 perftest 后立刻执行）：
      sticky 全 0            -> roce_dma 根本没发请求
      有 ARVALID 无 AR 握手   -> MCDMA 不接受请求，查 awuser/aruser、地址
      有 AR 握手 无 RVALID    -> 请求发出去了但读返回没回来，查主机侧 completion
      BRESP/RRESP != 0       -> 地址或权限错误
      有 AW/W 握手 无 B       -> 写响应丢失
      AW_HS==W_LAST_HS==B 且 AR_HS==R_LAST -> BAS 通路正常
    """
    sticky = card.roce(REG_DBG_BAS_STICKY)
    live = card.roce(REG_DBG_BAS_LIVE)
    rx = card.roce(REG_DBG_RX_STATE)
    cnt = read_counters(card)

    if no_reg(sticky) or no_reg(live) or no_reg(rx):
        print("调试寄存器读回 0xffffffff：当前镜像没有这些寄存器。")
        return 1

    bas = {k: cnt.get(k, 0) for k in
           ("BAS_AW_HS", "BAS_W_LAST_HS", "BAS_B", "BAS_AR_HS", "BAS_R_LAST")}

    if as_json:
        print(json.dumps({
            "sticky": sticky,
            "sticky_decoded": [n for b, n in BAS_STICKY_BITS if sticky & (1 << b)],
            "live": live,
            "live_decoded": {n: bool(live & (1 << b)) for b, n in BAS_LIVE_BITS},
            "counters": bas,
            "rx": {
                "resp_main_state": rx & 0xF,
                "disp_busy": bool((rx >> 8) & 1),
                "disp_owner": bool((rx >> 9) & 1),
                "staging_occupancy": (rx >> 16) & 0x3FF,
            },
        }, indent=2, ensure_ascii=False))
        return 0

    print("BAS sticky（累计事件，写 0x0400 可清）:")
    any_bit = False
    for bit, name in BAS_STICKY_BITS:
        on = bool(sticky & (1 << bit))
        any_bit |= on
        print(f"  [{bit:2d}] {'Y' if on else '.'} {name}")
    if not any_bit:
        print("  （全 0：引擎没有发出任何 BAS 请求）")

    print()
    print("BAS live（当前电平）:")
    print("  " + "  ".join(f"{n}={'1' if live & (1 << b) else '0'}"
                            for b, n in BAS_LIVE_BITS))
    print()
    print("BAS 握手计数:")
    for k, v in bas.items():
        print(f"  {k:<16s} {v}")

    ok_rw = (bas["BAS_AW_HS"] > 0 and
             bas["BAS_AW_HS"] == bas["BAS_W_LAST_HS"] == bas["BAS_B"] and
             bas["BAS_AR_HS"] == bas["BAS_R_LAST"])
    if bas["BAS_AW_HS"] == 0 and bas["BAS_AR_HS"] == 0:
        verdict = "没有任何握手 —— 引擎未发出请求"
    elif ok_rw:
        verdict = "读写计数自洽，BAS 通路正常工作"
    else:
        verdict = "计数不自洽 —— 有请求未完成（见上方 sticky 判读规则）"
    print(f"  判读：{verdict}")

    print()
    print("RX 状态:")
    print(f"  resp main_state    : {rx & 0xF}   (0=IDLE 时才算空闲)")
    print(f"  disp busy / owner  : {(rx >> 8) & 1} / {(rx >> 9) & 1}")
    staging_now = (rx >> 16) & 0x3FF
    print(f"  staging 占用       : {staging_now} / {STAGING_DEPTH}")
    # 门限随帧长变（B6388 起按 IP 长度精确预留），不拿单一帧长的 440 判，改用
    # 「按最大预留算的接受门限」——超过它连最长的帧也进不来，一定是真丢。
    hard_limit = staging_accept_limit(STAGING_MAX_BEATS)
    if staging_now > hard_limit:
        print(f"  注意：staging 占用 {staging_now} 超过硬门限 {hard_limit}"
              f"（= {STAGING_DEPTH} - {STAGING_MAX_BEATS} 拍预留 - {STAGING_GUARD}），"
              f"任何长度的新 RoCE 帧都会被整帧丢弃（RX_DROP 增长）。")
    if (rx >> 8) & 1 and (rx & 0xF) != 0:
        print("  注意：disp busy 且 resp 不在 IDLE —— RX 流水线可能仍卡着。")
    return 0


def _snap_bit_list(value, table, width_hint=8):
    """把位图解码成名字列表。"""
    return [name.strip() for bit, name in table if value & (1 << bit)]


def _decode_core_requester(word):
    """组 B requester 字（0x0680 + 0x40*i + 0x00）的字段解码。

    RTL 来源：roce_req.sv:1260 的 debug_state 低 20 位（roce_top.sv:759 原样平铺）
      {local_error, recovering, reads_outstanding[4:0], {2'b00, retry_left[2:0]},
       {1'b0, dispatch_reason[1:0]}, state[4:0]}
    展开成位号就是 §108.4 写的 [19]=local_error [18]=recovering [10:8]=retry_left
    [4:0]=state；retry_left 只有 3 位（0..7），[12:11] 恒 0，dispatch_reason 只有
    2 位，[7] 恒 0——所以 (>>8)&0x1F 与 (>>5)&0x7 取到的数值与真实字段相同。
    与旧地址 0x0560（lane0 别名）同一位序；0x0560 只反映 lane0，多 lane 卡死时
    它看起来可能完全正常，所以 4 QP 挂死必须逐 lane 看这四个字。
    """
    return {
        "state": DBG_REQ_STATES.get(word & 0x1F, "?"),
        "dispatch_reason": (word >> 5) & 0x7,
        "retry_left": (word >> 8) & 0x1F,
        "reads_outstanding": (word >> 13) & 0x1F,
        "recovering": (word >> 18) & 1,
        "local_error": (word >> 19) & 1,
    }


def cmd_dump_stall_snapshot(card, as_json, force=False, clear=False):
    """读「卡死快照」并解码：哪一级卡住、卡了多久、当时的 QP/PSN/长度/BAS 地址。

    这块寄存器的地址表在 RTL 的 roce/roce_debug.sv 文件头，两边的位段必须一致。

    判读顺序（先看 0x0514 的通道号，再对着快照字看）：
      通道 0..6  TX 某级 valid=1 而 ready=0 超过 1000 拍 → 看 SNAP[2] 判断上下游谁不动
      通道 8     roce_req 状态机停在非 IDLE      → 看 SNAP[6]/SNAP[9] 的 PSN 是否前进
      通道 9     roce_tx 组包停在非 BUILD_PREP    → 看 SNAP[7] 的 inflight/skip_align
      通道 10    roce_resp 主状态机停在非 IDLE    → 看 0x0564 的 out_state
      通道 11    roce_rx_parse 停在非 CAPTURE0    → RX 解析卡住（payload 没收完）
      通道 12    BAS 未完成读 >= 24               → 读请求发出去没回来，看 SNAP[13] 的 ARADDR
                                                  （门限原为 12，低于健康 write_bw 的 p50=18，
                                                   满速下必然触发，见优化记录 §108.1 第 3 条）
    另外逐 lane 打印组 B 的 requester 字（0x0680 + 0x40*i）：0x0560 只是 lane0 的别名，
    4 QP 场景下哪个 lane 的 req FSM / 重传计数异常，只能从这四个字看。
    """
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        print(f"0x{SLOT_ROCE + DBG_ID:08x} 读回 0x{ident:08x}（期望 0x{DBG_ID_MAGIC:08x}）：")
        print("当前镜像没有扩展调试寄存器（roce_debug.sv 是 2026-10-25 之后才加的），")
        print("先把这批 RTL 编进去再烧写。")
        return 1

    if clear:
        card.roce_write(DBG_CONTROL, DBG_CONTROL_CLEAR)
        time.sleep(0.01)
        print("已清快照与各通道计数（0x0510 <- 0x00000002）。")
    if force:
        card.roce_write(DBG_CONTROL, 1)
        time.sleep(0.01)
        print("已强制采样一次（0x0510 <- 1）。")
        if clear:
            print("注意：--clear --force 一起用时，下面这份快照是强制采样采出来的，")
            print("      通道号会是 0xFF，不代表真的卡死；判真卡死要看通道号不是 0xFF 的那次。")
        print()

    version = card.roce(DBG_VERSION)
    threshold = card.roce(DBG_THRESHOLD)
    count = card.roce(DBG_COUNT) & 0xFFFF
    status = card.roce(DBG_STATUS)
    valid = status & 1
    domain = (status >> 8) & 0x3
    channel = (status >> 16) & 0xFF

    snap = [card.roce(DBG_SNAP + 4 * i) for i in range(DBG_SNAP_WORDS)]
    dom_name = {0: "MAC", 1: "CORE", 2: "PCIE"}.get(domain, "?")

    req = card.roce(DBG_REQ_STATE)
    resp = card.roce(DBG_RESP_STATE)
    rxparse = card.roce(DBG_RX_PARSE)
    txbuild = card.roce(DBG_TX_BUILD)
    qpact = card.roce(DBG_QP_ACTIVE)
    dma = card.roce(DBG_DMA_STATE)
    bas = card.roce(DBG_BAS_OUTSTAND)
    sticky = card.roce(DBG_RESP_STICKY)
    txv = card.roce(DBG_TX_STAGE_VALID)
    txr = card.roce(DBG_TX_STAGE_READY)
    txl = card.roce(DBG_TX_STAGE_LAST)
    # 组 B（B6396 起）：每 lane 的 requester 字。0x0560 只是 lane0 的别名，多 lane
    # 卡死时必须逐 lane 读；老镜像这里读回 deadbeef，按「组 B 不存在」处理。
    core_req = {lane: card.roce(DBG_RDMA_CORE_BASE + DBG_RDMA_CORE_STRIDE * lane
                                + DBG_CORE_REQUESTER_STATE)
                for lane in range(MAX_LANES)}
    core_req_ok = {lane: not no_reg(word) for lane, word in core_req.items()}

    if as_json:
        print(json.dumps({
            "version": f"{version >> 16}.{(version >> 8) & 0xFF}",
            "threshold_cycles": threshold,
            "snapshot_count": count,
            "snapshot_valid": bool(valid),
            "channel": channel if valid else None,
            "channel_name": ("强制采样（--force）" if channel == 0xFF
                             else DBG_STALL_CHANNELS.get(channel, "?")) if valid else None,
            "domain": dom_name if valid else None,
            "age_cycles": snap[1],
            "snapshot": [f"0x{w:08x}" for w in snap],
            "tx_stage": {name.strip(): {"valid": bool(txv >> b & 1),
                                        "ready": bool(txr >> b & 1),
                                        "last": bool(txl >> b & 1)}
                         for b, name in DBG_TX_STAGES},
            "req_state": DBG_REQ_STATES.get(req & 0x1F, "?"),
            "resp_state": DBG_RESP_STATES.get(resp & 0xF, "?"),
            "resp_out_state": DBG_RESP_OUT_STATES.get((resp >> 4) & 0x7, "?"),
            "rx_parse_state": DBG_RX_PARSE_STATES.get(rxparse & 0x7, "?"),
            "tx_build_state": DBG_TX_BUILD_STATES.get(txbuild & 0x3, "?"),
            "qp": {"index": qpact & 0xF,
                   "state": QP_STATE_NAMES.get((qpact >> 4) & 0x7, "?"),
                   "next_psn": qpact >> 8},
            # 组 B 逐 lane requester：0x0560 只有 lane0，多 lane 现场必须看这里
            "core_lane_requester": [
                dict({"lane": lane, "raw": f"0x{core_req[lane]:08x}"},
                     **(_decode_core_requester(core_req[lane])
                        if core_req_ok[lane] else {"state": None}))
                for lane in range(MAX_LANES)],
            "dma": {"read_credit": dma & 0x3FF,
                    "second_phase": bool(dma >> 10 & 1),
                    "ar_fifo_valid": bool(dma >> 11 & 1),
                    "read_meta_valid": bool(dma >> 12 & 1),
                    "read_beat_valid": bool(dma >> 13 & 1),
                    "write_outstanding": (dma >> 14) & 0x1F},
            "bas": {"live": bas & 0xFF, "ar_outstanding": (bas >> 8) & 0xFF},
            "resp_sticky": {"bresp_err": bool(sticky & 8), "rresp_err": bool(sticky & 4),
                            "seen_ar": bool(sticky & 2), "seen_r_last": bool(sticky & 1)},
        }, indent=2, ensure_ascii=False))
        return 0

    print(f"扩展调试寄存器 v{version >> 16}.{(version >> 8) & 0xFF}"
          f"  判定门限 {threshold} 拍  已触发 {count} 次")
    print()

    print("== TX 流水实时电平（从主机到 MAC）==")
    print(f"  {'级':<20s} {'valid':>5s} {'ready':>5s} {'last':>5s}")
    for bit, name in DBG_TX_STAGES:
        print(f"  {name:<20s} {txv >> bit & 1:>5d} {txr >> bit & 1:>5d} {txl >> bit & 1:>5d}")
    stuck = [name.strip() for bit, name in DBG_TX_STAGES if (txv >> bit) & 1 and not ((txr >> bit) & 1)]
    print("  卡住的级：" + (", ".join(stuck) if stuck else "无（valid/ready 都成对）"))
    print()

    print("== 引擎状态机 ==")
    print(f"  roce_req   {DBG_REQ_STATES.get(req & 0x1F, '?'):<20s}"
          f" dispatch_reason={(req >> 5) & 0x7}"
          f" retry_left={(req >> 8) & 0x1F}"
          f" reads_outstanding={(req >> 13) & 0x1F}"
          f" recovering={req >> 18 & 1} local_error={req >> 19 & 1}")
    print(f"  roce_resp  main={DBG_RESP_STATES.get(resp & 0xF, '?'):<12s}"
          f" out={DBG_RESP_OUT_STATES.get((resp >> 4) & 0x7, '?')}")
    print(f"  rx_parse   {DBG_RX_PARSE_STATES.get(rxparse & 0x7, '?'):<20s}"
          f" disp busy/owner={(rxparse >> 3) & 0x3}  staging={(rxparse >> 6) & 0x3FF}")
    print(f"  tx build   {DBG_TX_BUILD_STATES.get(txbuild & 0x3, '?'):<20s}"
          # 0x056C 是 roce_top 平铺的 lane_tx_state（11 位，roce_top.sv:760-768）：
          #   [10:6] inflight[4:0]  [5:3] skip_align[2:0]  [2] 占位(0)  [1:0] build_state
          # 与 SNAP[7] 的 10 位 core_tx_state 差一位（那边没有 [2] 占位），别混用。
          f" align=0x{(txbuild >> 3) & 0x7:02x}"
          f"  inflight={(txbuild >> 6) & 0x1F}/16")
    print(f"  活动 QP    #{qpact & 0xF} state={QP_STATE_NAMES.get((qpact >> 4) & 0x7, '?')}"
          f" next_psn={qpact >> 8}")
    print()

    print("== 组 B：各 RDMA core lane 的 requester 字（0x0680 + 0x40*i）==")
    if not any(core_req_ok.values()):
        print("  四个 lane 都读回 deadbeef：镜像是 B6396 之前的（组 B 是那时加的），"
              "只能看上面 0x0560 的 lane0 别名。")
    else:
        for lane in range(MAX_LANES):
            base = DBG_RDMA_CORE_BASE + DBG_RDMA_CORE_STRIDE * lane
            raw = core_req[lane]
            if not core_req_ok[lane]:
                print(f"  lane{lane}（0x{base:04x}）读回 0x{raw:08x}：该 lane 窗口不存在")
                continue
            d = _decode_core_requester(raw)
            mark = ""
            if d["recovering"]:
                mark = "   <- 正在恢复：此时收到的 NAK-SEQ 可能被丢弃（§108.2）"
            elif d["local_error"] and d["state"] != "IDLE":
                mark = "   <- local_error=1，本 lane 判了本地错误"
            print(f"  lane{lane} 0x{raw:08x}  roce_req {d['state']:<20s}"
                  f" dispatch_reason={d['dispatch_reason']}"
                  f" retry_left={d['retry_left']}"
                  f" reads_outstanding={d['reads_outstanding']}"
                  f" recovering={d['recovering']} local_error={d['local_error']}{mark}")
    print()

    print("== DMA / BAS ==")
    print(f"  read_credit {(dma & 0x3FF)}/480  ({100.0 * (dma & 0x3FF) / 480:.0f}%)"
          f"   ar_fifo_valid={dma >> 11 & 1}  read_meta_valid={dma >> 12 & 1}"
          f"  read_beat_valid={dma >> 13 & 1}")
    print(f"  写请求未完成 {(dma >> 14) & 0x1F}    未完成 AR {(bas >> 8) & 0xFF}")
    if (dma & 0x3FF) < 40:
        print("  注意：读信用几乎耗尽，roce_dma 已经发不出新的读请求——这是 TX 全停的直接原因。")
    if ((bas >> 8) & 0xFF) >= DBG_BAS_STALL_THRESHOLD:
        print(f"  注意：未完成 AR >= {DBG_BAS_STALL_THRESHOLD} 且不降，读数据没回来"
              f"（查对端/主机的 completion）。")
    if sticky & 0xC:
        print(f"  注意：AXI 响应错误 bresp={sticky >> 3 & 1} rresp={sticky >> 2 & 1}（地址或权限问题）。")
    print(f"  响应观测：见过 AR 握手={sticky >> 1 & 1}  见过 R last={sticky & 1}")
    print()

    if not valid:
        print("== 卡死快照：未触发 ==")
        print(f"  没有哪一级的 valid 连续 {threshold} 拍等不到 ready。链路正常，或卡死是别的形态。")
        return 0

    print(f"== 卡死快照（触发过 {count} 次）==")
    if channel == 0xFF:
        print(f"  触发通道 0xFF = 强制采样（--force），不是真卡死；域 {dom_name}")
    else:
        print(f"  触发通道 {channel} = {DBG_STALL_CHANNELS.get(channel, '?')}（{dom_name} 域）")
    print(f"  持续 {snap[1]} 拍")
    # SNAP[0]：[7:0]=0x5A 版本标记 [9:8]=触发域 [17:10]=触发通道号 [31:24]=0xA5
    snap0_ch = (snap[0] >> 10) & 0xFF
    snap0_ch_name = ("强制采样（--force）" if snap0_ch == 0xFF
                     else DBG_STALL_CHANNELS.get(snap0_ch, "?"))
    print(f"  SNAP[0] 0x{snap[0]:08x}  tag=0x{snap[0] & 0xFF:02x}"
          f"  域={ {0: 'MAC', 1: 'CORE', 2: 'PCIE'}.get(snap[0] >> 8 & 0x3, '?') }"
          f"  通道={snap0_ch}（{snap0_ch_name}）  SNAP[1] 0x{snap[1]:08x}")
    txv_s, txr_s, txl_s = snap[2] & 0xFF, (snap[2] >> 8) & 0xFF, (snap[2] >> 16) & 0xFF
    print("  快照时刻 TX 各级：")
    for bit, name in DBG_TX_STAGES:
        mark = "  <- 卡住" if (txv_s >> bit) & 1 and not ((txr_s >> bit) & 1) else ""
        print(f"    {name:<20s} valid={txv_s >> bit & 1} ready={txr_s >> bit & 1}"
              f" last={txl_s >> bit & 1}{mark}")
    # axis_select.debug_state = {illegal, select[0], axis_last_reg[1], axis_last_reg[0], select[1]}
    # 位序按 axis_select.sv 的 assign 逐位对齐；旧代码按错位序解出的是 2'b10 假象。
    as_raw = snap[3] & 0x1F
    # 位序：debug_state = {illegal, select[0], axis_last_reg[1], axis_last_reg[0], select[1]}
    #   bit4=illegal  bit3=select[0]  bit2=last_reg[1]  bit1=last_reg[0]  bit0=select[1]
    # select 本身是 {select[1], select[0]}，所以高位取 bit0、低位取 bit3。
    # 早先这行写反过：健康态 2'b01 会被解成 2'b10，同一条输出里又说「非法态=0」，自相矛盾。
    as_sel = ((as_raw & 1) << 1) | ((as_raw >> 3) & 1)
    print(f"  axis_select 0x{as_raw:02x}  select=2'b{as_sel:02b}  "
          f"非法态={as_raw >> 4 & 1}  "
          f"(last_reg0={as_raw >> 1 & 1} last_reg1={as_raw >> 2 & 1})  "
          f"segm 0x{snap[3] >> 5 & 0x3FF:03x}  "
          f"(send_select={snap[3] >> 5 & 1} tready0={snap[3] >> 7 & 1} m_ready={snap[3] >> 8 & 1})")
    print(f"  RX valid=0x{snap[4] & 0x7:x} ready=0x{snap[4] >> 16 & 0x7:x}")
    # SNAP[5]：RX FIFO 水位，每 lane 取低 8 位 empty + 低 8 位 afull（不含 rx_mux，mux 在 0x0550）
    print(f"  rx fifo0 empty=0x{snap[5] & 0xFF:02x} afull=0x{snap[5] >> 8 & 0xFF:02x}"
          f"   fifo1 empty=0x{snap[5] >> 16 & 0xFF:02x} afull=0x{snap[5] >> 24 & 0xFF:02x}")
    sreq, sresp = snap[6] & 0x7FFF, (snap[6] >> 15) & 0x7F
    print(f"  roce_req  {DBG_REQ_STATES.get(sreq & 0x1F, '?'):<20s}"
          f" reads_outstanding={(sreq >> 13) & 0x1F} retry_left={(sreq >> 8) & 0x1F}")
    print(f"  roce_resp main={DBG_RESP_STATES.get(sresp & 0xF, '?')}"
          f" out={DBG_RESP_OUT_STATES.get((sresp >> 4) & 0x7, '?')}")
    # SNAP[7]：[10:0]=lane_tx_state（11 位，**与 0x056C 同布局**，roce_debug.sv:112），
    #          [27:12]=core_rx_state（16 位，[2:0] parse state [4:3] disp [15:6] staging）。
    # RTL 侧是 roce_debug.sv:801 的 `snap_word[7][10:0] <= lane_tx_state[0 +: 11]`，
    # 而 lane_tx_state 是 roce_top.sv:760-768 平铺的 11 位字：
    #   [10:6] inflight[4:0]  [5:3] skip_align[2:0]  [2] 占位(0)  [1:0] build_state
    # roce_tx.sv:357 的 core_tx_state 是 **10 位**（没有 [2] 占位），roce_top 平铺时插入
    # 了那个占位位，所以这里必须按 11 位解（>>6 / >>3），不能照 core_tx_state 的 >>5 / >>2。
    # 597ccc9 当时按 10 位改，0x056C 与 SNAP[7] 两处都偏了一位。
    stx = snap[7] & 0x7FF
    print(f"  tx build {DBG_TX_BUILD_STATES.get(stx & 0x3, '?')}"
          f"  inflight={(stx >> 6) & 0x1F}  align=0x{(stx >> 3) & 0x7:02x}"
          f"  rx_parse={DBG_RX_PARSE_STATES.get(snap[7] >> 12 & 0x7, '?')}")
    # qpc 低 32 位：bit[2:0] 是 state（其余是 dmac/tmac 低位），见 roce_pkg 的 qpc_* 函数
    print(f"  QPC 低 32 位 0x{snap[8]:08x}   QP state={QP_STATE_NAMES.get(snap[8] & 0x7, '?')}")
    print(f"  next_psn  {snap[9]:08x}")
    print(f"  tx_offset {snap[10]:08x}")
    # SNAP[11]：[4:0]=reads_outstanding  [10:5]=ack_counter
    print(f"  ack_counter={(snap[11] >> 5) & 0x3F} reads_outstanding={snap[11] & 0x1F}")
    print(f"  ARADDR    0x{(snap[12] << 32) | snap[13]:016x}")
    # SNAP[14]：[7:0]=ar_len  [11:8]=ar_hs（{arready, arvalid, rready, rvalid}）
    print(f"  ARLEN={snap[14] & 0xFF}  AR hs=0x{snap[14] >> 8 & 0xF:x}"
          f"  AWADDR[31:0] 0x{snap[15]:08x}")
    print()
    print(f"清除并重新采样：yuancli register dump_stall_snapshot --clear --force")
    return 0


def cmd_dbgscan(card, slots=(0x012, 0x017), as_json=False):
    """扫 slot 整窗，列出有内容的寄存器地址。

    avm_config 对未映射的地址返回 0xdeadbeef，所以「非 0 且非 deadbeef」就是真实寄存器
    或真实计数器。RTL 加了新寄存器但没写进本工具时，用它把地址找出来。
    """
    found = []
    for slot in slots:
        base_avmm = slot << 20
        for off in range(0, 0x1000, 4):
            v = card.read(base_avmm + off)
            if v not in (0, NO_REG, 0xFFFFFFFF):
                found.append((slot, off, v))
    if as_json:
        print(json.dumps([{"slot": f"0x{s:03x}", "offset": f"0x{o:03x}", "value": f"0x{v:08x}"}
                          for s, o, v in found], indent=2))
        return 0
    if not found:
        print("没有非 0 寄存器（整个窗口都是 0 / deadbeef）。")
        return 0
    print(f"{'AVMM 地址':<14s} {'值':<12s} 备注")
    for slot, off, v in found:
        note = ""
        if slot == 0x017:
            note = next((n for n, o in [("ID", 0x0), ("VERSION", 0x4), ("CAPS", 0x8),
                                        ("CTRL", 0xC), ("STATUS", 0x10), ("CORE_CLOCK", 0x20)]
                         if o == off), "")
        print(f"0x{slot:03x}{off:05x}   0x{v:08x}   {note}")
    return 0


