def read_debug_registers(card):
    """读扩展调试区；镜像里没有这批寄存器时返回 None。"""
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        return None
    return {name: card.roce(off) for name, off in DBG_REGISTERS}


def format_debug_registers(values):
    """把扩展调试区解码成可读文本行（dump_debug_registers 用）。"""
    out = []
    txv = values.get("dbg.tx_stage_valid", 0)
    txr = values.get("dbg.tx_stage_ready", 0)
    for bit, name in DBG_TX_STAGES:
        v, r = (txv >> bit) & 1, (txr >> bit) & 1
        out.append(f"  {name:<20s} valid={v} ready={r}" + ("   <- 卡住" if v and not r else ""))
    req = values.get("dbg.req_state", 0)
    resp = values.get("dbg.resp_state", 0)
    rxparse = values.get("dbg.rx_parse", 0)
    txbuild = values.get("dbg.tx_build", 0)
    qpact = values.get("dbg.qp_active", 0)
    dma = values.get("dbg.dma_state", 0)
    bas = values.get("dbg.bas_outstand", 0)
    sticky = values.get("dbg.resp_sticky", 0)
    out.append(f"  roce_req             {DBG_REQ_STATES.get(req & 0x1F, '?'):<20s}"
               f" reads_outstanding={(req >> 13) & 0x1F} recovering={req >> 18 & 1}")
    out.append(f"  roce_resp            {DBG_RESP_STATES.get(resp & 0xF, '?'):<20s}"
               f" out={DBG_RESP_OUT_STATES.get((resp >> 4) & 0x7, '?')}")
    out.append(f"  rx_parse             {DBG_RX_PARSE_STATES.get(rxparse & 0x7, '?'):<20s}"
               f" staging={(rxparse >> 6) & 0x3FF}")
    out.append(f"  tx build             {DBG_TX_BUILD_STATES.get(txbuild & 0x3, '?'):<20s}"
               f" inflight={(txbuild >> 6) & 0x1F}/16")
    out.append(f"  活动 QP              #{qpact & 0xF} "
               f"{QP_STATE_NAMES.get((qpact >> 4) & 0x7, '?')} next_psn={qpact >> 8}")
    out.append(f"  read_credit          {(dma & 0x3FF)}/480"
               + ("   <- 几乎耗尽，AR 发不出去" if (dma & 0x3FF) < 40 else ""))
    out.append(f"  未完成 AR            {(bas >> 8) & 0xFF}"
               + ("   <- 读数据没回来" if ((bas >> 8) & 0xFF) >= DBG_BAS_STALL_THRESHOLD else ""))
    if sticky & 0xC:
        out.append(f"  AXI 响应错误         bresp={sticky >> 3 & 1} rresp={sticky >> 2 & 1}")
    out.append(f"  响应观测             AR握手={sticky >> 1 & 1} R_last={sticky & 1}")
    return out


def cmd_lanes(card, as_json, clear_peak=False, diff=0.0):
    """每 lane RX 统计：两路 MAC 输入的帧数 / ICRC 错误 / 丢帧 / 暂存占用与峰值。

    为什么要分 lane 看：两路 MAC 输入各自独立暂存、独立丢帧。只暴露两路之和时，
    「丢包只发生在 lane1」这种单路故障会被摊平到 50%，看起来像"两边都在丢"，
    实际是一路坏了或者 LAN 侧只用了其中一路。

    读法：
      1) 正常时两路帧数应大致相等（差 <5%）
      2) 一路帧数显著偏少        -> 那一路的 LINK/MAC 有问题，不是引擎问题
      3) 一路 drop 涨而另一路为 0 -> 该路 staging 满，先看它的 peak 是否贴着上限
      4) peak 长期贴在 STAGING_PEAK_CEIL（504）-> 稳态贴门限（加深 staging 无用）
         peak 偶发冲高后回落     -> 偶发尖峰（加深有效）
      5) --clear-peak 清峰值后重跑一轮流量，能区分"这一轮才有"和"历史上就有"

    注意 peak 的单位是「拍」不是「帧」，而且 512 深度里最后 8 拍是保护带不参与接受判决，
    所以**理论峰值上限是 504，不是 512**。B6388 之前所有帧都按 MAX_BEATS=64 预留，
    接受门限固定 440，峰值顶到 449；B6388 起按 IP 长度精确预留，1 KB 帧门限 495，
    实测峰值 504 —— 这个数变高**说明预留逻辑生效了**，不是退化。
    """
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        print("调试寄存器不存在（ID 不是 RDBG）：镜像太老或引擎没使能。")
        return 6

    def snapshot():
        return {
            "lane0_frames": card.roce(DBG_LANE0_FRAMES),
            "lane1_frames": card.roce(DBG_LANE1_FRAMES),
            "lane0_icrc":   card.roce(DBG_LANE0_ICRC),
            "lane1_icrc":   card.roce(DBG_LANE1_ICRC),
            "lane0_drop":   card.roce(DBG_LANE0_DROP),
            "lane1_drop":   card.roce(DBG_LANE1_DROP),
            "staging":      card.roce(DBG_LANE_STAGING),
            "peak":         card.roce(DBG_LANE_PEAK),
        }

    if clear_peak:
        card.roce_write(DBG_LANE_CLEAR, 1)
        time.sleep(0.05)
        print("已清两路暂存峰值。")

    now = snapshot()
    if no_reg(now["lane0_frames"]):
        print("0x05D0 读回 deadbeef：镜像是 B6387 之前的，没有每 lane 统计。")
        return 6

    prev = None
    if diff and diff > 0:
        prev = now
        time.sleep(diff)
        now = snapshot()

    def delta(key):
        if prev is None:
            return 0
        return now[key] - prev[key]

    l0_stg = now["staging"] & 0x3FF
    l1_stg = (now["staging"] >> 10) & 0x3FF
    l0_peak = now["peak"] & 0x3FF
    l1_peak = (now["peak"] >> 10) & 0x3FF

    if as_json:
        print(json.dumps({
            "lane0": {"frames": now["lane0_frames"], "icrc": now["lane0_icrc"],
                      "drop": now["lane0_drop"], "staging": l0_stg, "peak": l0_peak},
            "lane1": {"frames": now["lane1_frames"], "icrc": now["lane1_icrc"],
                      "drop": now["lane1_drop"], "staging": l1_stg, "peak": l1_peak},
        }, indent=2))
        return 0

    tail = f"（{diff:g} 秒增量）" if prev is not None else ""
    print(f"{'lane':<6s} {'帧数':>14s} {'ICRC 错':>10s} {'丢帧':>10s} {'占用':>8s} {'峰值':>8s}{tail}")
    for name, fk, ik, dk, stg, pk in (
            ("lane0", "lane0_frames", "lane0_icrc", "lane0_drop", l0_stg, l0_peak),
            ("lane1", "lane1_frames", "lane1_icrc", "lane1_drop", l1_stg, l1_peak)):
        if prev is None:
            print(f"{name:<6s} {now[fk]:>14,d} {now[ik]:>10,d} {now[dk]:>10,d} {stg:>8d} {pk:>8d}")
        else:
            df, di, dd = delta(fk), delta(ik), delta(dk)
            print(f"{name:<6s} {'+'+format(df, ','):>14s} "
                  f"{'+'+format(di, ','):>10s} {'+'+format(dd, ','):>10s} "
                  f"{stg:>8d} {pk:>8d}")

    f0, f1 = now["lane0_frames"], now["lane1_frames"]
    if f0 and f1:
        ratio = min(f0, f1) / max(f0, f1)
        if ratio < 0.95:
            weak = "lane0" if f0 < f1 else "lane1"
            print(f"\n注意：{weak} 帧数只有另一路的 {ratio * 100:.1f}%，两路不平衡。"
                  f"先查那一路的 MAC/LINK，不是引擎问题。")
    for name, pk, dp in (("lane0", l0_peak, now["lane0_drop"]), ("lane1", l1_peak, now["lane1_drop"])):
        # 上限是 504（512 深度 - 8 拍保护带），不是 512；门限本身随帧长变，
        # 所以只对「峰值贴着上限」报警，不对某个帧长的门限报警。
        if pk >= STAGING_PEAK_CEIL - 4:
            print(f"\n注意：{name} 暂存峰值 {pk}/{STAGING_DEPTH}，已贴到上限 {STAGING_PEAK_CEIL}"
                  f"（= {STAGING_DEPTH} - {STAGING_GUARD} 保护带）。"
                  f"这是稳态贴门限，加深 staging 无效。")
        elif pk == 0 and dp:
            print(f"\n注意：{name} 有 {dp} 次丢帧但峰值为 0，说明峰值在清除后又被冲过一次，"
                  f"或有未同步的清除时序问题。")
    return 0


def _rx_lane_offsets(lane):
    base = DBG_RX_LANE_BASE + DBG_RX_LANE_STRIDE * lane
    return {name: base + off for name, off in (
        ("frames", DBG_RX_LANE_FRAMES), ("icrc", DBG_RX_LANE_ICRC_ERRORS),
        ("drop", DBG_RX_LANE_DROPPED_FRAMES), ("staging", DBG_RX_LANE_STAGING_LEVEL),
        ("peak", DBG_RX_LANE_STAGING_PEAK), ("mac_fifo", DBG_RX_LANE_MAC_FIFO),
        ("peak_clear", DBG_RX_LANE_PEAK_CLEAR))}


def _core_lane_offsets(lane):
    base = DBG_RDMA_CORE_BASE + DBG_RDMA_CORE_STRIDE * lane
    return {name: base + off for name, off in (
        ("requester", DBG_CORE_REQUESTER_STATE), ("responder", DBG_CORE_RESPONDER_STATE),
        ("dispatch", DBG_CORE_RX_DISPATCH), ("tx_build", DBG_CORE_TX_BUILD),
        ("active_qp", DBG_CORE_ACTIVE_QP), ("dma", DBG_CORE_DMA_STATE),
        ("bas", DBG_CORE_BAS_OUTSTANDING), ("sticky", DBG_CORE_RESP_STICKY),
        ("qpc_low", DBG_CORE_QP_CONTEXT_LOW), ("psn", DBG_CORE_PSN),
        ("ack", DBG_CORE_ACK_COUNTER), ("tx_offset", DBG_CORE_TX_OFFSET))}


def _lane_list(text, name, max_lanes=MAX_LANES):
    """把 'all' / '0' / '0,1' / '0 1' 解析成 lane 号列表。

    max_lanes 按命令区分：RX lane（组 A）恒为 MAX_RX_LANES=2（MAC 只有两路输入），
    RDMA core lane（组 B）是 MAX_LANES=4（与 RTL 的 LANES 一致）。
    """
    if text is None or text.lower() == "all":
        return list(range(max_lanes))
    parts = [p for p in text.replace(",", " ").split() if p]
    lanes = []
    for part in parts:
        try:
            lane = int(part, 0)
        except ValueError:
            raise SystemExit(f"{name}: 无法识别的 lane 号 {part!r}（要 'all' 或 0/1/...）")
        if not 0 <= lane < max_lanes:
            raise SystemExit(f"{name}: lane {lane} 超出范围（0..{max_lanes - 1}）")
        lanes.append(lane)
    return lanes


def cmd_rx_pkts(card, as_json, lane_text=None, diff=0.0, clear_peak=False):
    """按 RX lane 打印收包统计（组 A：0x0600 + 0x20*i）。

    与旧的 `register lanes` 的区别：旧命令读的是 0x05D0.. 那组老地址（只有 lane0/lane1
    成对硬编码），本命令读分组地址，参数能选 lane，加 lane 不用改工具。
    `register lanes` 保留为兼容入口，两者数据同源。
    """
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        print("调试寄存器不存在（ID 不是 RDBG）：镜像太老或引擎没使能。")
        return 6
    lanes = _lane_list(lane_text, "rx_pkts", MAX_RX_LANES)
    offsets = {lane: _rx_lane_offsets(lane) for lane in lanes}

    if clear_peak:
        for lane in lanes:
            card.roce_write(offsets[lane]["peak_clear"], 1)
        time.sleep(0.05)
        print(f"已清 lane {lanes} 的暂存峰值。")

    def sample():
        return {lane: {name: card.roce(off) for name, off in offsets[lane].items()}
                for lane in lanes}

    now = sample()
    for lane in lanes:
        if no_reg(now[lane]["frames"]):
            print(f"lane{lane} 帧数读回 deadbeef：镜像是 B6396 之前的，没有分组寄存器。"
                  f"改用 `register lanes` 读旧地址。")
            return 6

    prev = None
    if diff and diff > 0:
        prev = now
        time.sleep(diff)
        now = sample()

    if as_json:
        out = {}
        for lane in lanes:
            row = dict(now[lane])
            row["lane"] = lane
            if prev is not None:
                row["delta"] = {k: now[lane][k] - prev[lane][k] for k in ("frames", "icrc", "drop")}
            out[f"lane{lane}"] = row
        print(json.dumps(out, indent=2))
        return 0

    tail = f"（{diff:g} 秒增量）" if prev is not None else ""
    print(f"{'lane':<6s} {'帧数':>14s} {'ICRC 错':>10s} {'丢帧':>10s} {'占用':>8s} {'峰值':>8s}{tail}")
    for lane in lanes:
        row = now[lane]
        if prev is None:
            print(f"lane{lane:<2d} {row['frames']:>14,d} {row['icrc']:>10,d} {row['drop']:>10,d} "
                  f"{row['staging']:>8d} {row['peak']:>8d}")
        else:
            df = row["frames"] - prev[lane]["frames"]
            di = row["icrc"] - prev[lane]["icrc"]
            dd = row["drop"] - prev[lane]["drop"]
            print(f"lane{lane:<2d} {'+'+format(df, ','):>14s} {'+'+format(di, ','):>10s} "
                  f"{'+'+format(dd, ','):>10s} {row['staging']:>8d} {row['peak']:>8d}")

    frames = [now[lane]["frames"] for lane in lanes]
    if len(frames) > 1 and min(frames) and max(frames):
        ratio = min(frames) / max(frames)
        if ratio < 0.95:
            weak = lanes[frames.index(min(frames))]
            print(f"\n注意：lane{weak} 帧数只有最高一路的 {ratio * 100:.1f}%，两路不平衡。"
                  f"先查那一路的 MAC/LINK，不是引擎问题。")
    for lane in lanes:
        if now[lane]["peak"] >= STAGING_PEAK_CEIL - 4:
            print(f"\n注意：lane{lane} 暂存峰值 {now[lane]['peak']}/{STAGING_DEPTH}，已贴到上限 "
                  f"{STAGING_PEAK_CEIL}。这是稳态贴门限，加深 staging 无效。")
    # B6418 起：两路按到达顺序合并的事件计数（老镜像读回 deadbeef，不打印）
    merge_force, merge_rebase = card.roce(DBG_RX_MERGE_FORCE), card.roce(DBG_RX_MERGE_REBASE)
    if not no_reg(merge_force):
        print(f"\n两路合并（B6418+）：顺序超时强制放行 {merge_force}，空闲重新对齐 {merge_rebase}"
              + ("" if merge_force == 0 and merge_rebase == 0 else
                 "  ← 非 0：帧序号与 rx_path_avst 交替失步过，见 roce_rx_front.sv 文件头"))
    return 0


def cmd_rx_demux(card, as_json, lane_text=None, diff=0.0):
    """按 RDMA core lane 打印 demux 分流统计（组 D：0x0640 + 0x10*i，需 B6408 及以后镜像）。

    与 `rx_pkts`（组 A）的区别：组 A 是两路 MAC 物理输入的统计，回答「链路上收了多少」；
    这里统计的是**分流之后**每条 RDMA core lane 的负载，回答「哪条引擎吃不下」。

    三个量的读法：
      frames    : 分到该 lane 的帧数。按 QPN 取模分配，正常应大致均衡
                  （同一 QP 的包永远落同一条 lane，-q N 时 N 个 QP 均匀散开）
      stall     : 该 lane 的 FIFO 满、上游被反压的**拍数**。这是 lane 级缓冲压力的
                  直接观测量——q1 压满一条 lane 时它会持续涨
      sop_stall : 其中「卡住的是帧首拍」的次数。首拍进不去意味着整包要等，
                  持续出现才是真的降速风险；帧中间偶尔 stall 一拍无碍

    **这里没有丢弃数**：demux 的 FIFO 是 FRAME_FIFO=0，靠 in_ready 反压，自己不丢包。
    真实的整帧丢弃发生在上游 roce_rx_front 的 staging FIFO，看 `rx_pkts` 的 drop。
    """
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        print("调试寄存器不存在（ID 不是 RDBG）：镜像太老或引擎没使能。")
        return 6
    lanes = _lane_list(lane_text, "rx_demux", MAX_LANES)

    def sample():
        out = {}
        for lane in lanes:
            base = DBG_RX_DEMUX_BASE + DBG_RX_DEMUX_STRIDE * lane
            out[lane] = {
                "frames": card.roce(base + DBG_DEMUX_LANE_FRAMES),
                "stall": card.roce(base + DBG_DEMUX_LANE_STALL),
                "sop_stall": card.roce(base + DBG_DEMUX_LANE_SOP_STALL),
            }
        return out

    now = sample()
    for lane in lanes:
        if no_reg(now[lane]["frames"]):
            print(f"lane{lane} 读回 deadbeef：镜像是 B6408 之前的，没有 demux 分组寄存器。")
            return 6

    prev = None
    if diff and diff > 0:
        prev = now
        time.sleep(diff)
        now = sample()

    if as_json:
        out = {}
        for lane in lanes:
            row = dict(now[lane])
            if prev is not None:
                row["delta"] = {k: now[lane][k] - prev[lane][k] for k in row}
            row["lane"] = lane
            out[f"demux{lane}"] = row
        print(json.dumps(out, indent=2))
        return 0

    print(f"RX demux 分流统计（组 D，基址 0x{DBG_RX_DEMUX_BASE:04x}，步长 0x{DBG_RX_DEMUX_STRIDE:x}）")
    print(f"{'lane':<6s}{'frames':>16s}{'stall':>16s}{'sop_stall':>16s}")
    for lane in lanes:
        row = now[lane]
        if prev is None:
            print(f"{lane:<6d}{row['frames']:>16,d}{row['stall']:>16,d}{row['sop_stall']:>16,d}")
        else:
            df = row["frames"] - prev[lane]["frames"]
            ds = row["stall"] - prev[lane]["stall"]
            dss = row["sop_stall"] - prev[lane]["sop_stall"]
            print(f"{lane:<6d}{'+' + format(df, ','):>16s}{'+' + format(ds, ','):>16s}"
                  f"{'+' + format(dss, ','):>16s}")

    # 判读提示
    frames = [now[lane]["frames"] for lane in lanes]
    if len(frames) > 1 and min(frames) and max(frames) / min(frames) > 1.2:
        weak = lanes[frames.index(min(frames))]
        print(f"\n注意：lane{weak} 分到的帧数只有最多的一条的 "
              f"{min(frames) / max(frames) * 100:.1f}%。正常应大致均衡——"
              f"QPN 低位分布不均说明 QP 数远少于 lane 数（多 QP 测试才看这个）。")
    stalls = [now[lane]["stall"] for lane in lanes]
    if sum(stalls) and prev is not None:
        hot = lanes[stalls.index(max(stalls))]
        print(f"\n本轮 lane{hot} 反压最多（{stalls[hot]:,} 拍）。q1 场景下全压一条 lane 是预期的；"
              f"q4 仍集中则说明该 lane 的引擎慢，不是分流不均。")
    return 0


def cmd_rdmacore(card, as_json, lane_text=None, diff=0.0):
    """按 RDMA core lane 打印引擎状态（组 B：0x0680 + 0x40*i）。

    每个 lane 是一个独立的 roce_engine 实例（自己的 req/resp/disp/tx/dma/QPC）。
    两个 lane 的包流是分开的，所以「哪个 lane 卡住」必须分开看——旧地址 0x0560 只
    反映 lane0，lane1 卡死时旧地址看起来完全正常（B6395 上板那次就是这样）。
    """
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        print("调试寄存器不存在（ID 不是 RDBG）：镜像太老或引擎没使能。")
        return 6
    lanes = _lane_list(lane_text, "rdmacore", MAX_LANES)
    offsets = {lane: _core_lane_offsets(lane) for lane in lanes}

    def sample():
        return {lane: {name: card.roce(off) for name, off in offsets[lane].items()}
                for lane in lanes}

    now = sample()
    for lane in lanes:
        if no_reg(now[lane]["requester"]):
            print(f"lane{lane} 读回 deadbeef：镜像是 B6396 之前的，没有分组寄存器。"
                  f"改用 `register dump_debug_registers` 读旧地址（只有 lane0）。")
            return 6

    prev = None
    if diff and diff > 0:
        prev = now
        time.sleep(diff)
        now = sample()

    if as_json:
        out = {}
        for lane in lanes:
            row = dict(now[lane])
            row["lane"] = lane
            out[f"core{lane}"] = row
        print(json.dumps(out, indent=2))
        return 0

    for lane in lanes:
        row = now[lane]
        req, resp = row["requester"], row["responder"]
        txb, dma, act = row["tx_build"], row["dma"], row["active_qp"]
        print(f"lane{lane}（base 0x{DBG_RDMA_CORE_BASE + DBG_RDMA_CORE_STRIDE * lane:04x}）")
        print(f"  requester   {DBG_REQ_STATES.get(req & 0x1F, '?'):<20s}"
              f" dispatch_reason={(req >> 5) & 0x7} retry_left={(req >> 8) & 0x1F}"
              f" reads_outstanding={(req >> 13) & 0x1F}")
        print(f"  responder   {DBG_RESP_STATES.get(resp & 0xF, '?'):<20s}"
              f" out={DBG_RESP_OUT_STATES.get((resp >> 4) & 0x7, '?')}")
        busy, owner = row["dispatch"] & 1, (row["dispatch"] >> 1) & 1
        print(f"  dispatch    busy={busy} owner={owner}"
              + ("   <- 本 lane 的 disp 挂着，后续包头进不来" if busy else ""))
        print(f"  tx build    {DBG_TX_BUILD_STATES.get(txb & 0x3, '?'):<20s}"
              f" inflight={(txb >> 6) & 0x1F}/16")
        print(f"  active QP   #{act & 0xF} {QP_STATE_NAMES.get((act >> 4) & 0x7, '?')}"
              f" next_psn={(act >> 8) & 0xFFFFFF}")
        credit = dma & 0x3FF
        print(f"  dma         read_credit={credit}/480"
              + ("   <- 几乎耗尽，AR 发不出去" if credit < 40 else ""))
        print(f"  bas         live=0x{row['bas'] & 0xFF:02x} 未完成 AR={(row['bas'] >> 8) & 0xFF}")
        print(f"  tx_offset   {row['tx_offset']}")
        if prev is not None:
            print(f"  ({diff:g} 秒内 未完成 AR {prev[lane]['bas'] >> 8} -> {row['bas'] >> 8})")
    return 0


def cmd_tx_merge(card, as_json, diff=0.0):
    """TX 汇合与 RX 分流状态（组 C：0x0740）。

    两级 2:1 汇合都是包级轮询、包内不切换。`in_packet=1` 且选中口没有数据 = 卡在半个包上。
    B6395 上板实测过这种形态：对端掉链把 QDMA 那一路的半包截断，tlast 永远不来，
    整条 TX 停摆（ping 都不通）。B6396 起 mux 有包内空洞超时，残包会被放弃并计入 aborts。
    """
    ident = card.roce(DBG_ID)
    if no_reg(ident) or ident != DBG_ID_MAGIC:
        print("调试寄存器不存在（ID 不是 RDBG）：镜像太老或引擎没使能。")
        return 6
    base = DBG_TX_MERGE_BASE
    names = [("qdma_state", DBG_TX_MERGE_QDMA_STATE), ("qdma_aborts", DBG_TX_MERGE_QDMA_ABORTS),
             ("lane_state", DBG_TX_MERGE_LANE_STATE), ("lane_aborts", DBG_TX_MERGE_LANE_ABORTS),
             ("rx_split", DBG_RX_SPLIT_STATE)]
    now = {name: card.roce(base + off) for name, off in names}
    if no_reg(now["qdma_state"]):
        print("读回 deadbeef：镜像早于 B6396，没有 TX 汇合分组寄存器。")
        return 6
    prev = None
    if diff and diff > 0:
        prev = dict(now)
        time.sleep(diff)
        now = {name: card.roce(base + off) for name, off in names}

    if as_json:
        print(json.dumps(now, indent=2))
        return 0

    for label, state_key, abort_key in (
            ("QDMA / RoCE 汇合", "qdma_state", "qdma_aborts"),
            ("lane0 / lane1 汇合", "lane_state", "lane_aborts")):
        state = now[state_key]
        in_packet, port, priority = state & 1, (state >> 1) & 1, (state >> 2) & 1
        print(f"{label}  in_packet={in_packet} port={port} priority={priority}"
              + ("   <- 卡在半个包里（等该口的 tlast）" if in_packet else ""))
        aborts = now[abort_key]
        if prev is not None:
            print(f"                残包放弃 {prev[abort_key]} -> {aborts}（{diff:g} 秒）")
        else:
            print(f"                残包放弃累计 {aborts}" + ("   <- 非 0 说明发生过包内截断" if aborts else ""))
    split = now["rx_split"]
    print(f"RX 分流      payload_busy={split & 1} owner={(split >> 1) & 1}"
          + ("   <- 正在搬运某个 lane 的 payload" if split & 1 else ""))
    return 0


def cmd_dbgall(card, as_json, diff=0, scan=False):
    """全量调试寄存器：RoCE CSR + system_config 调试区，可选二次采样给差值。

    为什么单独一个命令：判「TX 卡在哪一级」需要一条流水上的计数同时看。
    B6369 的 TX 不通就是靠这张表定位的——主机侧包已产生、两侧 MAC 链路 up，
    但对端一个包都收不到，此时只有 axis_select / segm2gap / gap2mac 这组计数
    能说明帧到底停在了哪一级。

    读法：
      1) 不带参数            打一次快照
      2) --diff 5            隔 5 秒再采一次，只打印有变化的项和差值（推荐）
      3) --scan              slot 0x012 / 0x017 整窗 0x000..0xFFF 扫一遍，
                             只列非 0 / 非 deadbeef 的字，用来找 RTL 新增的寄存器
    """
    sysv = {}
    for off, name, _ in SYS_DBG_64:
        lo = card.sys(off)
        hi = card.sys(off + 4)
        sysv[name] = lo if no_reg(hi) else (lo | (hi << 32))
    for off, name, _ in SYS_DBG_32:
        sysv[name] = card.sys(off)
    for off, name, _hint in SYS_STATUS:
        sysv[name] = card.sys(off)
    for base, name in SYS_PFC_BASE:
        for p in range(8):
            sysv[f"{name}[{p}]"] = card.sys(base + 4 * p)

    rocev = read_counters(card)
    rocev["CTRL"] = card.roce(REG_CTRL)
    rocev["STATUS"] = card.roce(REG_STATUS)
    dbgv = read_debug_registers(card)      # 没有这批寄存器时返回 None

    base = dict(sysv)
    base.update({f"roce.{k}": v for k, v in rocev.items()})
    if dbgv is not None:
        base.update(dbgv)

    if diff:
        time.sleep(diff)
        now = {}
        for off, name, _ in SYS_DBG_64:
            lo = card.sys(off)
            hi = card.sys(off + 4)
            now[name] = lo if no_reg(hi) else (lo | (hi << 32))
        for off, name, _ in SYS_DBG_32:
            now[name] = card.sys(off)
        for off, name, _hint in SYS_STATUS:
            now[name] = card.sys(off)
        for b_, n_ in SYS_PFC_BASE:
            for p in range(8):
                now[f"{n_}[{p}]"] = card.sys(b_ + 4 * p)
        r2 = read_counters(card)
        r2["CTRL"] = card.roce(REG_CTRL)
        r2["STATUS"] = card.roce(REG_STATUS)
        now.update({f"roce.{k}": v for k, v in r2.items()})
        dbgv2 = read_debug_registers(card)
        if dbgv2 is not None:
            now.update(dbgv2)
    else:
        now = None

    if as_json:
        out = {"bdf": card.bdf, "sample": base}
        if now is not None:
            out["diff_seconds"] = diff
            out["delta"] = {k: now[k] - base.get(k, 0)
                            for k in now if now[k] != base.get(k)}
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0

    print(f"BDF : {card.bdf}")
    print()
    if now is None:
        print("== TX 流水（越往下越靠近 MAC）==")
        for n in SYS_TX_CHAIN:
            print(f"  {n:<20s} {sysv.get(n, 0):>12d}")
        print()
        print("== RX 流水 ==")
        for n in ("rx_path_eop_cnt", "rx_rcv_last0_cnt", "rx_rcv_last1_cnt"):
            print(f"  {n:<20s} {sysv.get(n, 0):>12d}")
        print()
        print("== MAC 错误 ==")
        for _, n, h in SYS_DBG_64:
            print(f"  {n:<20s} {sysv.get(n, 0):>12d}   {h}")
        print()
        print("== 链路 ==")
        print(f"  rx_fault            0x{sysv.get('rx_fault', 0):08x}")
        print(f"  link_up             0x{sysv.get('link_up', 0):08x}")
        print()
        print("== RoCE 计数器 ==")
        for n in COUNTERS:
            v = rocev[n]
            mark = f"   <- {DIAG_HINTS[n]}" if v and n in DIAG_HINTS else ""
            print(f"  {n:<20s} {v:>12d}{mark}")
        print()
        if dbgv is None:
            print("== 扩展调试区 ==")
            print(f"  0x{SLOT_ROCE + DBG_ID:08x} 读回 0x{card.roce(DBG_ID):08x}"
                  f"（期望 0x{DBG_ID_MAGIC:08x}）：当前镜像没有 roce_debug 寄存器。")
        else:
            print("== 扩展调试区（0x0500..）==")
            for line in format_debug_registers(dbgv):
                print(line)
            if dbgv.get("dbg.status", 0) & 1:
                print(f"  已触发卡死快照 {dbgv.get('dbg.snapshot_count', 0) & 0xFFFF} 次，"
                      f"通道 {(dbgv.get('dbg.status', 0) >> 16) & 0xFF}"
                      f" —— `yuancli register dump_stall_snapshot` 看现场")
        print()
        print("== PFC 计数（每优先级）==")
        for b_, n_ in SYS_PFC_BASE:
            vals = " ".join(f"{p}:{sysv.get(f'{n_}[{p}]', 0)}" for p in range(8))
            print(f"  {n_:<10s} {vals}")
        print()
        print("提示：加 --diff 5 看 5 秒内哪些计数在涨。判 TX 卡死看上面 TX 流水那一列，"
              "哪个先不涨就卡在哪一级；扩展调试区给出每一级的实时 valid/ready 与卡死快照，"
              "`dump_stall_snapshot` 单独看现场。")
        return 0

    # --diff：只打印变化项，按 TX 流水顺序优先
    order = SYS_TX_CHAIN + ["rx_path_eop_cnt", "rx_rcv_last0_cnt", "rx_rcv_last1_cnt"]
    order += [n for _, n, _ in SYS_DBG_64]
    order += [f"roce.{n}" for n in COUNTERS]
    order += [f"{n_}[{p}]" for _, n_ in SYS_PFC_BASE for p in range(8)]
    order += ["rx_fault", "link_up", "roce.STATUS", "roce.CTRL"]
    seen = set()
    changed = []
    for k in order:
        if k in seen:
            continue
        seen.add(k)
        d = now.get(k, 0) - base.get(k, 0)
        if d:
            changed.append((k, base.get(k, 0), now.get(k, 0), d))
    for k in now:
        if k not in seen:
            d = now[k] - base.get(k, 0)
            if d:
                changed.append((k, base.get(k, 0), now[k], d))

    print(f"== {diff} 秒内的变化（只列有变化的项）==")
    if not changed:
        print("  没有任何计数变化。")
        if not any(sysv.get(n, 0) for n in SYS_TX_CHAIN):
            print("  TX 流水全 0：主机侧在这段时间没发包，或发包被上游拦住了。")
    for k, b_, n_, d in changed:
        print(f"  {k:<22s} {b_:>12d} -> {n_:>12d}   +{d}")
    return 0


def cmd_softrst(card, timeout=2.0):
    """软复位数据通路（写 REG_SOFT_RST，任意值触发）。

    与 reset 的区别：reset 写 CTRL[1] 是旧镜像入口，当前镜像该位无效；
    softrst 写 0x0414，把复位展宽成 256 个 core 周期再同步到 mac_clk / pcie_clk，
    复位除 CSR 之外的全部数据通路。CSR 不复位，CTRL/MAC/IP 保持。
    不清理主机内存里的 SQ/RQ/CQ 环，对端 QP 也是旧状态，perftest 要两端重跑。
    """
    before = card.roce(REG_SOFT_RST)
    if no_reg(before):
        print("REG_SOFT_RST 读回 0xffffffff：当前镜像没有这个寄存器（旧 RTL）。")
        print("退路：PCIe secondary bus reset")
        print("  setpci -s <bridge> BRIDGE_CONTROL=40 ; sleep 1 ; setpci -s <bridge> BRIDGE_CONTROL=00")
        print(f"  setpci -s {card.bdf} COMMAND=0546")
        return 1

    status_before = card.roce(REG_STATUS)
    ctrlsave = card.roce(REG_CTRL)
    counters_before = read_counters(card)

    card.roce_write(REG_SOFT_RST, 1)
    t0 = time.time()
    seen_active = False
    while time.time() - t0 < timeout:
        v = card.roce(REG_SOFT_RST)
        if v & 1:
            seen_active = True
        elif seen_active:
            break
        time.sleep(0.002)

    time.sleep(0.05)
    elapsed = time.time() - t0
    after = card.roce(REG_SOFT_RST)
    status_after = card.roce(REG_STATUS)
    counters_after = read_counters(card)

    print(f"REG_SOFT_RST : 0x{before:08x} -> 0x{after:08x}")
    print(f"复位{'已观察到进行中' if seen_active else '未观察到进行中（可能太快或未生效）'}"
          f"，耗时 {elapsed * 1000:.1f} ms")
    print(f"STATUS       : 0x{status_before:08x} -> 0x{status_after:08x}"
          f"  link={'UP' if status_after & 1 else 'DOWN'}")
    print(f"CTRL         : 0x{ctrlsave:08x}（CSR 不复位，应保持不变）")
    print(f"IPV4         : {fmt_ip(card.roce(REG_IPV4))}（应保持）")

    reset_cnt = [k for k in COUNTERS
                 if counters_after.get(k, 0) < counters_before.get(k, 0)]
    if reset_cnt:
        print(f"计数器已清零：{', '.join(reset_cnt)}")
    else:
        print("计数器未清零 —— 这些计数器在 pcie_clk/mac_clk 域，"
              "没被 dp_*_rst 覆盖就说明复位分发有遗漏。")
    return 0


def cmd_reset(card):
    """写 CTRL[1] 软复位（旧镜像入口；新镜像请用 softrst）。"""
    before = card.roce(REG_CTRL)
    card.roce_write(REG_CTRL, before | CTRL_SOFT_RST)
    time.sleep(0.2)
    after = card.roce(REG_CTRL)
    card.roce_write(REG_CTRL, after | CTRL_ENABLE | CTRL_SOFT_RST)
    time.sleep(0.05)
    card.roce_write(REG_CTRL, CTRL_ENABLE)
    time.sleep(0.2)
    final = card.roce(REG_CTRL)
    print(f"CTRL: 0x{before:08x} -> 0x{final:08x}")
    if not (final & CTRL_SOFT_RST):
        print("soft_rst 已自清。若当前镜像未把 soft_rst 接到数据通路，计数器不会清零。")
        print("新镜像请用 `yuancli register soft_reset`。")
    print(f"STATUS: 0x{card.roce(REG_STATUS):08x}")
    return 0


