  yuancli quality_of_service -d 6f:00.0 --pfc -p 3 -s on       # 打开优先级 3 的 PFC
  yuancli quality_of_service -d 6f:00.0 --pfc 0,0,0,1,0,0,0,0  # 整字节掩码
