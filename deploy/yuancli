        print(f"  {p.opt} {value:<16s}  -> {why}")
    print()
    print("要真正支持这些参数，需要先在 RTL 里加寄存器与逻辑，见 `yuancli capabilities`。")
    return 4


# ============================================================ qos
def parse_pfc_mask(text):
    """'0,0,0,1,0,0,0,0' -> 0x08"""
    parts = [x.strip() for x in text.split(",")]
    if len(parts) != 8:
        raise SystemExit("--pfc 掩码要 8 个逗号分隔的 0/1，例如 0,0,0,1,0,0,0,0")
    value = 0
    for i, item in enumerate(parts):
        if item not in ("0", "1"):
            raise SystemExit(f"--pfc 第 {i} 项不是 0/1：{item}")
        if item == "1":
            value |= 1 << i
    return value


def _parse_prios(spec):
    """'3' / '0,3,5' / 'all' / '0-7' -> set of priorities"""
    if spec is None:
        return set()
    spec = spec.strip().lower()
    if spec in ("all", "*", "-1"):
        return set(range(8))
    out = set()
    for part in spec.replace(" ", "").split(","):
        if not part:
            continue
        if "-" in part.strip(".."):
            lo, hi = part.split("-", 1)
            lo, hi = int(lo, 0), int(hi, 0)
            if not (0 <= lo <= hi <= 7):
                raise SystemExit(f"优先级范围要在 0..7：{part}")
            out |= set(range(lo, hi + 1))
        else:
            v = int(part, 0)
            if not 0 <= v <= 7:
                raise SystemExit(f"优先级要在 0..7：{part}")
            out.add(v)
    return out


def _mask_of(prios):
    m = 0
    for q in prios:
        m |= 1 << q
    return m


def _fmt_prios(mask):
    prios = [i for i in range(8) if mask & (1 << i)]
    if not prios:
        return "（全关）"
    return " ".join(str(q) for q in prios)


def cmd_pfc_status(card, as_json=False):
    """pfc status：tx/rx 使能、802.3x、每优先级 FIFO 计数（带 RoCE 通路说明）。"""
    tx, rx, raw = pfc_read(card)
    tx_prios, tx_pause = pfc_decode(tx)
    rx_prios, rx_pause = pfc_decode(rx)
    stats = pfc_stats(card)
    out = {
        "bdf": card.bdf,
        "reg": f"0x{raw:08x}",
        "tx_pfc": tx,
        "rx_pfc": rx,
        "tx_prios": tx_prios,
        "rx_prios": rx_prios,
        "pause_tx": tx_pause,
        "pause_rx": rx_pause,
        "stats": stats,
    }
    if as_json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0

    print(f"PFC 状态     BDF {card.bdf}")
    print(f"  寄存器 0x054 : 0x{raw:08x}   tx=0x{tx:03x}  rx=0x{rx:03x}")
    print(f"  TX PFC 使能  : {_fmt_prios(tx & 0xFF)}")
    print(f"  RX PFC 已收到: {_fmt_prios(rx & 0xFF)}   （对端此刻在暂停这些优先级）")
    print(f"  802.3x pause : tx={'on' if tx_pause else 'off'}  rx={'on' if rx_pause else 'off'}")
    print()
    print("  pfc_function 每优先级 FIFO 计数（prio: drop / in / out）：")
    for r in stats:
        flag = "  <-- 有丢帧" if r["drop"] else ""
        print(f"    prio {r['prio']}: {r['drop']:>10d} / {r['in']:>10d} / {r['out']:>10d}{flag}")
    print()
    if any(r["drop"] for r in stats):
        print("  drop 不为 0：pause 期间包继续写入该优先级 FIFO，满后丢弃（不是反压）。")
        print("  详见 PFC / DCQCN 配置说明。")
    print()
    print("  范围说明：")
    print("    tx_pfc[7:0] → eth400g MAC 的 PFC 帧生成（对端会停该优先级）")
    print("    rx_pfc[7:0] → 两处消费者：QDMA 路径的 pfc_function，以及 RoCE 引擎")
    print("                  roce_pfc 的收方向准入（RX_HONOR / RX_WD / ANY_ALL）")
    print("                  统计用 `yuancli pfc status` / `pfc counters`（0x900+ 段）")
    print("    rx_pfc[8]   → 802.3x PAUSE：QDMA 路径整体停，RoCE 侧由 HONOR[8] 决定")
    return 0


def _pause_arg(value):
    """`--pause` 的 nargs="?" 三态 -> True / False / None（None = 不动 bit8）。

    const="on"，所以不给值等于 on；给 off 才是放开。force_xoff 与旧别名
    enable/disable 共用这一处，避免两边的三态口径再分叉。
    """
    if value == "on":
        return True
    if value == "off":
        return False
    return None


def cmd_pfc_set(card, prios, on, pause=None):
    """pfc enable/disable：改 tx_pfc[7:0]；pause 可选改 bit8。"""
    tx_before, _, _ = pfc_read(card)
    new = tx_before & 0x1FF
    if prios is not None:
        mask = _mask_of(prios)
        new = (new | mask) if on else (new & ~mask & 0xFF) | (new & 0x100)
    if pause is not None:
        new = (new | 0x100) if pause else (new & ~0x100)
    readback = pfc_write(card, new)
    tx_after = readback & 0x1FF
    print(f"tx_pfc 0x054 : 0x{tx_before:03x} -> 0x{tx_after:03x}")
    print(f"  PFC 使能   : {_fmt_prios(tx_after & 0xFF)}")
    print(f"  802.3x     : {'on' if tx_after & 0x100 else 'off'}")
    if (tx_after & 0x1FF) != (new & 0x1FF):
        print("  回读与写入不一致 —— 寄存器没写进去，检查 Bus Master / BAR2 映射。")
        return 1
    return 0


# ============================================================ RoCE 引擎 PFC 控制器（0x800 窗口）
def pfc_engine_present(card):
    """读 PFC_ID 判断镜像有没有 roce_pfc（full_pfc_func 及以后）。"""
    return card.roce(PFC_ID) == PFC_ID_MAGIC


def _require_pfc_engine(card):
    if pfc_engine_present(card):
        return
    ident = card.roce(PFC_ID)
    print(f"RoCE PFC 控制器不在线：0x{PFC_ID:03x} 读回 0x{ident:08x}（期望 0x{PFC_ID_MAGIC:08x}）。")
    print("当前镜像不含 roce_pfc（需要 full_pfc_func 分支的镜像）。")
    raise SystemExit(4)


def _decode_bits(value, bits):
    return [name for name, bit, _ in bits if value & (1 << bit)]


def pfc_lanes_occupancy(card, max_lanes=2):
    """返回 {lane: [occ_p0..p7]}。max_lanes 是 MAC 输入路数（roce_rx_front 固定 2）。"""
    return {lane: [card.roce(PFC_OCC(lane, p)) for p in range(8)] for lane in range(max_lanes)}


def pfc_counters(card):
    out = {}
    for name, index, _ in PFC_CNT_NAMES:
        out[name] = card.roce(PFC_CNT(index))
    return out


def _pfc_tick_to_us(card, ticks):
    core_mhz = card.roce(REG_CORE_CLOCK) or 250
    return ticks / float(core_mhz)


def cmd_pfc_engine_status(card, as_json=False):
    """引擎侧 PFC 全貌：配置、生效 pause、我方 XOFF、占用、计数（带 µs 换算）。"""
    ctrl, ctrl2 = card.roce(PFC_CTRL), card.roce(PFC_CTRL2)
    status, status2 = card.roce(PFC_STATUS), card.roce(PFC_STATUS2)
    tx_mask = card.roce(PFC_TX_MASK)
    honor = card.roce(PFC_RX_HONOR)
    thr = {f"prio{p}": {"xoff": card.roce(PFC_XOFF_THR(p)), "xon": card.roce(PFC_XON_THR(p))}
           for p in range(8)}
    occ = pfc_lanes_occupancy(card)
    cnt = pfc_counters(card)
    core_mhz = card.roce(REG_CORE_CLOCK) or 250
    out = {
        "bdf": card.bdf,
        "id": f"0x{card.roce(PFC_ID):08x}",
        "ctrl": ctrl, "ctrl_enabled": _decode_bits(ctrl, PFC_CTRL_BITS),
        "ctrl2": ctrl2, "ctrl2_enabled": _decode_bits(ctrl2, PFC_CTRL2_BITS),
        "tx_mask": tx_mask, "rx_honor": honor,
        "all_thr": card.roce(PFC_ALL_THR), "hold_us": card.roce(PFC_HOLD_US),
        "wd_tx_us": card.roce(PFC_WD_TX_US), "wd_rx_us": card.roce(PFC_WD_RX_US),
        "wd_warn_us": card.roce(PFC_WD_WARN_US),
        "pause_effective": status & 0x1FF,
        "tx_pfc": (status >> 16) & 0x1FF,
        "escalated": bool(status & (1 << 25)), "egress_blocking": bool(status & (1 << 26)),
        "rx_wd_hit": status2 & 0xFF, "tx_wd_force": (status2 >> 8) & 0xFF,
        "tx_wd_warn": (status2 >> 16) & 0xFF,
        "thresholds": thr,
        "occupancy": {f"lane{lane}": occ[lane] for lane in occ},
        "core_clock_mhz": core_mhz,
        "counters": cnt,
    }
    if as_json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0

    print(f"RoCE 引擎 PFC 控制器   BDF {card.bdf}   ID {out['id']}")
    print(f"  CTRL  0x{ctrl:02X}：{', '.join(out['ctrl_enabled']) or '（全关）'}")
    print(f"  CTRL2 0x{ctrl2:02X}：{', '.join(out['ctrl2_enabled']) or '（无）'}")
    print(f"  TX_MASK  0x{tx_mask:02X}（可以单独暂停：{_fmt_prios(tx_mask)}）")
    print(f"  RX_HONOR 0x{honor:03X}（理会 per-prio：{_fmt_prios(honor & 0xFF)}；802.3x："
          f"{'理会' if honor & 0x100 else '忽略'}）")
    _warn = card.roce(PFC_WD_WARN_US)
    _warn_txt = "   WD_WARN n/a(B6434+)" if _warn == 0xDEADBEEF else f"   WD_WARN {_warn} µs"
    print(f"  ALL_THR {out['all_thr']} 拍   HOLD_US {out['hold_us']} µs   "
          f"WD_TX {out['wd_tx_us']} µs   WD_RX {out['wd_rx_us']} µs{_warn_txt}")
    print()
    print(f"  生效 pause [8:0] = 0x{out['pause_effective']:03X}"
          f"（per-prio {_fmt_prios(out['pause_effective'] & 0xFF)}；"
          f"802.3x {'是' if out['pause_effective'] & 0x100 else '否'}）")
    print(f"  我方发出 [8:0]   = 0x{out['tx_pfc']:03X}"
          f"（per-prio {_fmt_prios(out['tx_pfc'] & 0xFF)}；"
          f"802.3x {'是' if out['tx_pfc'] & 0x100 else '否'}）")
    print(f"  升级中 {'是' if out['escalated'] else '否'}   出口挡帧中 {'是' if out['egress_blocking'] else '否'}")
    wd = ", ".join(f"prio{p}" for p in range(8) if out["rx_wd_hit"] & (1 << p))
    print(f"  RX 看门狗命中：{wd or '无'}   TX 看门狗强制放开："
          f"{', '.join(f'prio{p}' for p in range(8) if out['tx_wd_force'] & (1 << p)) or '无'}")
    if out.get("tx_wd_warn"):
        print(f"  TX 看门狗告警：{', '.join(f'prio{p}' for p in range(8) if out['tx_wd_warn'] & (1 << p))}"
              f"（只告警，未放开 XOFF）")
    print()
    print("  staging 占用（拍；128 B/拍；XOFF 阈值 / XON 阈值）：")
    for p in range(8):
        vals = "/".join(f"L{lane}:{occ[lane][p]:>4d}" for lane in occ)
        print(f"    prio {p}: {vals}   阈值 {thr[f'prio{p}']['xoff']}/{thr[f'prio{p}']['xon']}")
    print()
    # 只打非零项：链路正常时 48 行全 0，会把真正要看的几行淹掉。全量用 `pfc counters`。
    nonzero = [(n, i, d) for n, i, d in PFC_CNT_NAMES if cnt[n]]
    print(f"  计数（TICK 单位 = core_clk 拍，{core_mhz} MHz；只列非零项，全量用 `pfc counters`）：")
    if not nonzero:
        print("    全部为 0（注：DROP 是绝对值，其余是段数/拍数）")
    for name, index, desc in nonzero:
        value = cnt[name]
        if "tick" in name:
            print(f"    {name:<20s} {value:>12d}   {value / core_mhz:>10.3f} µs   {desc}")
        else:
            print(f"    {name:<20s} {value:>12d}   {'':>10s}     {desc}")
    print()
    print("  计数器与 0x054 的 pfc_function 计数（QDMA 路径）互不相干：这里只统计 RoCE 引擎。")
    return 0


def cmd_pfc_engine_config(card, args):
    """写引擎 PFC 配置；不给任何参数时等同 status 的配置段。"""
    changed = []
    if args.ctrl is not None:
        card.roce_write(PFC_CTRL, args.ctrl & 0xF)
        changed.append(("CTRL", card.roce(PFC_CTRL)))
    if args.ctrl2 is not None:
        card.roce_write(PFC_CTRL2, args.ctrl2 & 0x1F)
        changed.append(("CTRL2", card.roce(PFC_CTRL2)))
    if args.tx_mask is not None:
        card.roce_write(PFC_TX_MASK, args.tx_mask & 0xFF)
        changed.append(("TX_MASK", card.roce(PFC_TX_MASK)))
    if args.rx_honor is not None:
        card.roce_write(PFC_RX_HONOR, args.rx_honor & 0x1FF)
        changed.append(("RX_HONOR", card.roce(PFC_RX_HONOR)))
    if args.all_thr is not None:
        card.roce_write(PFC_ALL_THR, args.all_thr & 0xFFF)
        changed.append(("ALL_THR", card.roce(PFC_ALL_THR)))
    if args.hold_us is not None:
        card.roce_write(PFC_HOLD_US, args.hold_us & 0xFFFF)
        changed.append(("HOLD_US", card.roce(PFC_HOLD_US)))
    if args.wd_tx_us is not None:
        card.roce_write(PFC_WD_TX_US, args.wd_tx_us & 0xFFFFFF)
        changed.append(("WD_TX_US", card.roce(PFC_WD_TX_US)))
    if args.wd_rx_us is not None:
        card.roce_write(PFC_WD_RX_US, args.wd_rx_us & 0xFFFFFF)
        changed.append(("WD_RX_US", card.roce(PFC_WD_RX_US)))
    if getattr(args, "wd_warn_us", None) is not None:
        card.roce_write(PFC_WD_WARN_US, args.wd_warn_us & 0xFFFFFF)
        v = card.roce(PFC_WD_WARN_US)
        changed.append(("WD_WARN_US", v if v not in (0xDEADBEEF, 0xFFFFFFFF) else "写已生效，读回 n/a"))
    if args.xoff_thr is not None:
        for prio, value in enumerate(args.xoff_thr.split(",")):
            card.roce_write(PFC_XOFF_THR(prio), int(value, 0) & 0x3FF)
        changed.append(("XOFF_THR", [card.roce(PFC_XOFF_THR(p)) for p in range(8)]))
    if args.xon_thr is not None:
        for prio, value in enumerate(args.xon_thr.split(",")):
            card.roce_write(PFC_XON_THR(prio), int(value, 0) & 0x3FF)
        changed.append(("XON_THR", [card.roce(PFC_XON_THR(p)) for p in range(8)]))
    if not changed:
        print("没有给参数，只显示当前配置（完整状态用 `yuancli pfc status`）。")
        return cmd_pfc_engine_status(card)
    print(f"PFC 配置已写入 BDF {card.bdf}：")
    for name, value in changed:
        print(f"  {name:<10s} = {value}")
