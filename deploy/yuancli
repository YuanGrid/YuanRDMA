# ============================================================ 分级交互（? / tab / shell）
# 随便打到哪里，`?` 就列出这一级能接什么。
# 命令树本身就是 build_parser() 建出来的 argparse 树，所以这里不需要另一份清单。

def _subparsers(parser):
    """取 parser 的 subparsers action；没有就返回 None。"""
    for a in parser._actions:
        if isinstance(a, argparse._SubParsersAction):
            return a
    return None


def _walk(argv):
    """按 argv 逐级下钻命令树，返回 (当前 parser, 已消费的下标)。

    遇到不认识的下标就停——它可能是选项值或位置参数的开始。
    """
    parser = build_parser()
    i = 0
    while i < len(argv):
        sp = _subparsers(parser)
        if sp is None or argv[i] not in sp.choices:
            break
        parser = sp.choices[argv[i]]
        i += 1
    return parser, i


def _visible_options(parser):
    """当前级可用的选项（跳过 -h 和子命令 action）。"""
    out = []
    for a in parser._actions:
        if isinstance(a, argparse._SubParsersAction):
            continue
        if a.option_strings == ["-h", "--help"]:
            continue
        out.append(a)
    return out


def print_level_help(argv, prefix=""):
    """`yuancli register ?` / `yuancli quality_of_service --pfc ?` 的实现：列出这一级的下一级。

    prefix 只用于交互 shell 的 `re?` 写法：只列以它开头的子命令/选项，
    命令行上用 `yuancli register ?` 就够了（bash 会把裸 ? 当通配符，记得加引号）。
    """
    parser, used = _walk(argv)
    sp = _subparsers(parser)

    path = " ".join(argv[:used]) if used else ""
    title = f"yuancli {path}".strip()
    head = f"{title} 的下一级" + (f"（前缀 `{prefix}`）" if prefix else "")
    print(f"\n{head}：")

    names = []
    if sp is not None:
        # 只列规范名：sp.choices 里每个别名都占一个键（probe/probe_engine 同一个 parser），
        # 而 _choices_actions 每个命令只有一条，.dest 就是规范名。
        names = sorted(ca.dest for ca in sp._choices_actions
                       if ca.dest and ca.dest.startswith(prefix))
    if names:
        width = max([len(c) for c in names] + [4])
        print("\n  子命令：")
        for name in names:
            # _ChoicesPseudoAction 里有 help 文本，没有就用子 parser 的 description 首行
            h = ""
            for ca in sp._choices_actions:
                if ca.dest == name:
                    h = ca.help or ""
                    break
            print(f"    {name:<{width}}  {h.splitlines()[0] if h else ''}")

    opts = [a for a in _visible_options(parser)
            if not prefix or any(o.startswith(prefix) for o in a.option_strings)]
    if opts:
        width = max(len(o) for a in opts for o in a.option_strings)
        print("\n  选项：")
        for a in opts:
            flag = ", ".join(a.option_strings)
            meta = ""
            if a.choices:
                meta = " {%s}" % "|".join(map(str, a.choices))
            elif a.metavar:
                meta = f" {a.metavar}"
            print(f"    {flag:<{width}}{meta}")
            if a.help:
                print(f"    {'':<{width}}  {a.help}")

    if not names and not opts:
        if prefix:
            print(f"    没有以 `{prefix}` 开头的命令。")
        else:
            print("    （这一级没有更多命令）")
    print()
    return 0


def _shell_prompt(path):
    # yuancli> / yuancli(qos)# / yuancli(reg)#
    return "yuancli>" if not path else f"yuancli({'.'.join(path)})# "


def interactive_shell():
    """分级交互 shell。"""
    path = []          # 已进入的子命令路径

    print("yuancli 交互模式：`?` 看下一级，`exit` 退出，`end` 退回上一级。")
    while True:
        try:
            line = input(_shell_prompt(path))
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        line = line.strip()
        if not line:
            continue

        # `re?` / `reg dbg?` 这种前缀问号：只列匹配前缀的下一级
        if line.endswith("?"):
            text = line[:-1].strip()
            if not text:
                print_level_help(path)
                continue
            toks = path + text.split()
            # 最后一个词是过滤前缀，它前面的词决定在哪一级列
            print_level_help(toks[:-1], prefix=toks[-1])
            continue

        if line in ("exit", "quit"):
            return 0
        if line in ("end", "back", ".."):
            if path:
                path.pop()
            continue

        words = line.split()

        # 单独一个子命令名 -> 进入该级上下文。
        # 只有下面还有子命令的级才进（caps 这种叶子命令要直接执行，
        # 否则会卡在 yuancli(caps)# 里，后面输入什么都解析不了）。
        parser, _ = _walk(path)
        sp = _subparsers(parser)
        if (sp is not None and len(words) == 1 and words[0] in sp.choices
                and _subparsers(sp.choices[words[0]]) is not None):
            path.append(words[0])
            continue

        try:
            rc = run_command(path + words)
        except SystemExit as e:
            # argparse 出错（参数不合法）会 sys.exit，交互模式下不能让它把 shell 打死
            rc = e.code if isinstance(e.code, int) else 1
        except (FileNotFoundError, PermissionError, OSError, IOError) as e:
            print(f"  错误：{e}")
            rc = 1
        if rc:
            print(f"  (退出码 {rc})")


