        v = card.roce(CNP_BTH)
        print(f"  BTH      = 0x{v:02X}（BECN={v & 1} FECN={(v >> 1) & 1} → byte4 = 0x{(v << 6):02X}）")
    if args.ctrl is None and args.cnp_dscp is None and args.min_us is None and args.bth is None:
        print("没有给参数，只显示当前配置（完整状态用 `yuancli ecn status`）。")
