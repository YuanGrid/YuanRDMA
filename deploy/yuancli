def dispatch_params(card, group, args):
    params = PARAMS[group]
    given = collect_given(args, params)
    if not given:
        print(f"{group}: 没有指定任何参数。用 --show 查看当前状态，或 -h 看可用参数。")
        return 0
    unsupported = [(p, v) for p, v in given if p.handler is None]
    supported = [(p, v) for p, v in given if p.handler is not None]

    rc = 0
    for p, value in supported:
        if p.handler == "qpc_tos":
            if p.opt == "--force_dscp":
                rc = max(rc, do_force_dscp(card, value))
            elif p.opt == "--data_ecn":
                rc = max(rc, do_data_ecn(card, value))
        else:
            fn = PARAM_HANDLERS.get(p.handler)
            if fn is None:
                continue
            rc = max(rc, fn(card, value))
    if unsupported:
        rc = max(rc, report_unsupported(group, unsupported))
    return rc


