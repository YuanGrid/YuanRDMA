# ---- staging FIFO 深度常量（roce_rx_front.sv） ----
# 占用判据在 RTL 里是 `staging_occupancy <= DEPTH - sop_reserve - GUARD`，
# sop_reserve 是按本帧实际拍数算的（B6388 起，1 KB 帧 9 拍；更早是固定 MAX_BEATS=64）。
# 所以「门限」不是一个常数：它随帧长变化。但**峰值上限**是个常数——
# 接受一帧后占用最多再加 sop_reserve 拍，即 (DEPTH-GUARD-sop_reserve)+sop_reserve = DEPTH-GUARD。
# 判读一律对这个峰值上限做，别再硬编码某个帧长的门限值。
STAGING_DEPTH = 512
STAGING_GUARD = 8
STAGING_PEAK_CEIL = STAGING_DEPTH - STAGING_GUARD     # 504
STAGING_MAX_BEATS = 64                                # 超长帧截断上限，短帧按它预留


def staging_accept_limit(frame_beats):
    """给定帧拍数，返回该帧在 RTL 里被接受的最大当前占用。

    帧长未知时用 STAGING_MAX_BEATS（短帧/超长帧都是这样预留的），得 440——
    这正是 B6388 之前所有帧的口径，也是工具里那个 440 的来源。
    """
    reserve = min(max(frame_beats, 1), STAGING_MAX_BEATS)
    return STAGING_DEPTH - reserve - STAGING_GUARD
