# ============================================================ qos / flexcc 参数落到真寄存器
# 手册 yuncli 的参数名（qos / flexcc）在这里映射到引擎寄存器。单位约定：
#   yuncli 的时间参数是**纳秒**，RTL 寄存器是**微秒**，统一向上取整（1..65535）。
def _ns_to_us(value, optname):
    ns = int(value, 0)
    if ns < 0:
        raise SystemExit(f"{optname} 不能为负：{value}")
    us = (ns + 999) // 1000
    if us > 0xFFFF:
        raise SystemExit(f"{optname} {ns} ns 超过 RTL 上限（65535 µs）")
    return us


def _need_pfc_engine(card, optname):
    if not pfc_engine_present(card):
        print(f"{optname}: RoCE PFC 控制器不在线（0x{PFC_ID:03x} 读回 "
              f"0x{card.roce(PFC_ID):08x}）——需要 full_pfc_func 及以后的镜像。")
        return False
    return True


def _need_dcqcn_engine(card, optname):
    if not dcqcn_engine_present(card):
        print(f"{optname}: RoCE DCQCN 不在线（0x{DCQCN_ID:03x} 读回 "
              f"0x{card.roce(DCQCN_ID):08x}）——需要 B6425 及以后的镜像。")
        return False
    return True


def h_pfc_wd_en(card, value):
    if not _need_pfc_engine(card, "--pfc_watchdog_en"):
        return 4
    on = int(value, 0) != 0
    ctrl2 = card.roce(PFC_CTRL2)
    new = (ctrl2 | (1 << 4)) if on else (ctrl2 & ~(1 << 4))
    card.roce_write(PFC_CTRL2, new & 0x1F)
    wd_tx = card.roce(PFC_WD_TX_US)
    if on and wd_tx == 0:                      # 打开但周期是 0 等于没开，补默认 100 ms
        card.roce_write(PFC_WD_TX_US, 100000)
        wd_tx = card.roce(PFC_WD_TX_US)
        print("  WD_TX_US 原为 0，已补默认 100000 µs（否则看门狗不会触发）。")
    if not on:
        card.roce_write(PFC_WD_TX_US, 0)
        card.roce_write(PFC_WD_RX_US, 0)
        wd_tx = 0
    print(f"  pfc_watchdog_en = {'on' if on else 'off'}"
          f"（CTRL2=0x{card.roce(PFC_CTRL2):02X}，WD_TX_US={wd_tx} µs）")
    return 0


