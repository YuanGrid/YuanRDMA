def cmd_pfc_engine_counters(card, as_json=False, diff_seconds=0.0):
    """只打印引擎 PFC 计数器；--diff 时按秒算速率（看 XOFF 是否在抖动）。"""
    def snapshot():
        return pfc_counters(card)

    first = snapshot()
    core_mhz = card.roce(REG_CORE_CLOCK) or 250
    rates = None
    if diff_seconds > 0:
        t0 = time.time()
        time.sleep(diff_seconds)
        second = snapshot()
        elapsed = max(time.time() - t0, 1e-6)
        rates = {k: (second[k] - first[k]) / elapsed for k in first}
        first = second
    out = {"bdf": card.bdf, "counters": first, "core_clock_mhz": core_mhz}
    if rates is not None:
        out["rates_per_second"] = rates
        out["diff_seconds"] = diff_seconds
    if as_json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return 0
    print(f"RoCE 引擎 PFC 计数器   BDF {card.bdf}   core {core_mhz} MHz")
    for name, index, desc in PFC_CNT_NAMES:
        extra = ""
        if "tick" in name:
            extra += f"  ({first[name] / core_mhz:.3f} µs)"
        if rates is not None:
            extra += f"  [{rates[name]:+.1f}/s]"
        if first[name] or rates:
            print(f"  {name:<20s} {first[name]:>12d}{extra}   {desc}")
    return 0


