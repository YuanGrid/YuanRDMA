# ---- 板级 GPIO / I2C / 光模块控制引脚的 I/O 约束 ----
# 均为 IOBANK_2C，IO 标准 1.2 V。1.2-V 不支持显式驱动强度/slew 设置（Quartus 报 12417/12418），
# 由 fitter 按 I/O 标准推断；只补 IO_STANDARD 即可满足 Assembler 出编程文件的条件。
set_instance_assignment -name IO_STANDARD "1.2 V" -to opt_mod_lpm -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to opt_mod_rst -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[0] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[1] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[2] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[3] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[4] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[5] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[6] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to fpga_cpld_gpio[7] -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_m_fpga_scl -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_m_fpga_sda -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_opt_scl0 -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_opt_sda0 -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_opt_scl1 -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_opt_sda1 -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_s_fpga_scl -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to i2c_s_fpga_sda -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to ex_reset_n -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to opt_mod_pst -entity YuanRDMA
set_instance_assignment -name IO_STANDARD "1.2 V" -to opt_mod_los -entity YuanRDMA
# i2c_opt_scl1/sda1 由测试计数器驱动，板上未接（旧版交付 QSF 亦无位置约束），
# 用 fitter 自动放置的位置固定，避免 Assembler 因缺位置拒绝出 SOF。
set_location_assignment PIN_MC25 -to i2c_opt_scl1 -comment IOBANK_2C
set_location_assignment PIN_JL29 -to i2c_opt_sda1 -comment IOBANK_2C
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_clock_in.ip
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_reset_in.ip
set_global_assignment -name QSYS_FILE ../system/axi4_adapter.qsys
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_axi_bridge_0.ip
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_axi_bridge_1.ip
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_axi_bridge_2.ip
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_clock_bridge_0.ip
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_reset_bridge_0.ip
set_global_assignment -name IP_FILE ../system/ip/axi4_adapter/axi4_adapter_axi_bridge_3.ip
set_global_assignment -name SIGNALTAP_FILE ../debug/pcie5.stp
set_global_assignment -name QIP_FILE support_logic/YuanRDMA_auto_tiles.qip -comment "This order dependent setting should appear after all other QIP_FILE and IP_FILE settings" -tag quartus_tlg
set_global_assignment -name SPD_FILE support_logic/YuanRDMA_auto_tiles.spd -tag quartus_tlg
