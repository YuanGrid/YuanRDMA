# ---- 小范围 LogicLock（2026-11-12 试验，roce-optimization-log §65；2026-11-13 B6439 落盘）----
# 依据：B6437 网表只换 QSF、seed 1 的对照试验（/home/roce_build/ll_A/runs/ll_small_s1）——
#   PCIe pld_clkout −0.645 / 8641 端点 → −0.106 / 4870 端点
#   MAC tx_clkout    0.000 / 0                                     0.000 / 0（已收敛）
#   core outclk1    −0.115                                        −0.295（略差，靠 RTL 侧的 G0.1 拆流水解决）
# 只框「违例集中、必须彼此靠近」的最小实例；全部 RESERVE OFF（不排斥别的逻辑进入），
# 矩形取自 B6437 fit 的实际节点分布（p5..p95），不用 AUTO，不改任何全局 Fitter/seed 设置。
# 前两个是上面 U_pci5_top 保留区（X12 Y140 X131 Y299）的子区域，必须落在其内。
set_instance_assignment -name PLACE_REGION "X96 Y168 X131 Y240" -to "U_pci5_top|U_MCDMA|intel_pcie_axi_mcdma_0|mcdma_top_i|mcdma_wrapper_i|gen_enable_dma.mcdma_dma_i|mcdma_d2hdm_i"
set_instance_assignment -name RESERVE_PLACE_REGION OFF -to "U_pci5_top|U_MCDMA|intel_pcie_axi_mcdma_0|mcdma_top_i|mcdma_wrapper_i|gen_enable_dma.mcdma_dma_i|mcdma_d2hdm_i"
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to "U_pci5_top|U_MCDMA|intel_pcie_axi_mcdma_0|mcdma_top_i|mcdma_wrapper_i|gen_enable_dma.mcdma_dma_i|mcdma_d2hdm_i"
set_instance_assignment -name REGION_NAME LL_MCDMA_D2HDM -to "U_pci5_top|U_MCDMA|intel_pcie_axi_mcdma_0|mcdma_top_i|mcdma_wrapper_i|gen_enable_dma.mcdma_dma_i|mcdma_d2hdm_i"
set_instance_assignment -name PLACE_REGION "X12 Y205 X50 Y270" -to "U_pci5_top|U_pcie5x16|intel_pcie_ss_axi_0|u_rtile|intel_pcie_rtile_ast_qhip|u_rnr_pcie_soft_rx_tx_wrapper|u_rnr_pcie_ehp_wrapper_0"
set_instance_assignment -name RESERVE_PLACE_REGION OFF -to "U_pci5_top|U_pcie5x16|intel_pcie_ss_axi_0|u_rtile|intel_pcie_rtile_ast_qhip|u_rnr_pcie_soft_rx_tx_wrapper|u_rnr_pcie_ehp_wrapper_0"
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to "U_pci5_top|U_pcie5x16|intel_pcie_ss_axi_0|u_rtile|intel_pcie_rtile_ast_qhip|u_rnr_pcie_soft_rx_tx_wrapper|u_rnr_pcie_ehp_wrapper_0"
set_instance_assignment -name REGION_NAME LL_RTILE_EHP0 -to "U_pci5_top|U_pcie5x16|intel_pcie_ss_axi_0|u_rtile|intel_pcie_rtile_ast_qhip|u_rnr_pcie_soft_rx_tx_wrapper|u_rnr_pcie_ehp_wrapper_0"
# 下面两个在保留区之外（X>=132）。u_bas_mon 不属于 U_pci5_top，进不了保留区，只能贴着 X131 边界放在 BAS 总线旁。
set_instance_assignment -name PLACE_REGION "X140 Y118 X175 Y162" -to "u7_rx_filet|u3_rx_mux_nto1"
set_instance_assignment -name RESERVE_PLACE_REGION OFF -to "u7_rx_filet|u3_rx_mux_nto1"
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to "u7_rx_filet|u3_rx_mux_nto1"
set_instance_assignment -name REGION_NAME LL_RX_MUX -to "u7_rx_filet|u3_rx_mux_nto1"
set_instance_assignment -name PLACE_REGION "X132 Y196 X143 Y215" -to "u99_roce_top|u_bas_mon"
set_instance_assignment -name RESERVE_PLACE_REGION OFF -to "u99_roce_top|u_bas_mon"
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to "u99_roce_top|u_bas_mon"
set_instance_assignment -name REGION_NAME LL_BAS_MON -to "u99_roce_top|u_bas_mon"
