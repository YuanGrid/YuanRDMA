# 统一换行符：仓库内与工作区一律 LF，避免 Windows 下 checkout 被转成 CRLF
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.bin  binary
*.zip  binary
*.gz   binary
*.tar  binary

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
